# 世途旅行 · 生产环境变量模板
# 用法：cp docs/env.prod.example .env.prod && vim .env.prod

# ── 数据库 ──────────────────────────────────────────────
# 用 openssl rand -base64 24 生成
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_24_CHARS

# ── JWT 密钥（必须 >= 32 字符，随机）──
# 用 openssl rand -base64 48 生成
JWT_ACCESS_SECRET=CHANGE_ME_48_BYTES_BASE64_ENCODED_FOR_ACCESS_TOKEN
JWT_REFRESH_SECRET=CHANGE_ME_48_BYTES_BASE64_ENCODED_FOR_REFRESH_TOKEN
# 生产建议：access 15 分钟，refresh 7 天
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ── CORS（必填，禁用 *）──────────────────────────────────
CORS_ORIGINS=https://sales.citur.com,https://admin.citur.com

# ── 公网基准 URL（必填）──
# 支付网关回调 notifyUrl / sandbox 跳转页基准；不能用 Host header（可伪造）
APP_PUBLIC_URL=https://api.citur.com

# ── 前端构建时 API base（构建镜像时传入）──
# 同域反代保持 /api；如独立 API 域名改成 https://api.citur.com
VITE_API_BASE=/api

# ── 日志 ───────────────────────────────────────────────
LOG_LEVEL=info

# ── 支付网关 ─────────────────────────────────────────────
# sandbox | live
PAYMENT_MODE=sandbox
SANDBOX_WEBHOOK_SECRET=CHANGE_ME_SANDBOX_SECRET_32_CHARS

# ── 真实支付（PAYMENT_MODE=live 才必填）──
#
# === WeChat Pay v3 ===
# 来源：微信支付商户平台（https://pay.weixin.qq.com）
# 步骤：进入后台 → API 安全 → 设置 APIv3 密钥 + 下载商户 API 证书
#
# WECHAT_APPID=wx1234567890abcdef         # 公众号/小程序/APP AppID
# WECHAT_MCH_ID=1600123456                # 商户号（10 位数字）
# WECHAT_API_V3_KEY=32CHARS_RANDOM_KEY_HERE                # APIv3 密钥（32 字符）
# WECHAT_SERIAL_NO=ABCDEF1234567890ABCDEF1234567890ABCDEF12  # 商户证书序列号
# WECHAT_PRIVATE_KEY_PATH=/secrets/wechat/apiclient_key.pem  # 商户 API 私钥（挂载到容器）
# WECHAT_PLATFORM_CERT_PATH=/secrets/wechat/wechatpay_platform_cert.pem  # 平台证书（可选，SDK 自动拉取）
#
# === Alipay ===
# 来源：蚂蚁开放平台（https://open.alipay.com）
# 步骤：创建应用 → 应用公钥上传到支付宝 → 下载支付宝公钥
#
# ALIPAY_APPID=2021000112345678           # 16 位应用 ID
# ALIPAY_PRIVATE_KEY_PATH=/secrets/alipay/app_private_key.pem   # 应用私钥（PKCS#8 或 #1）
# ALIPAY_PUBLIC_KEY_PATH=/secrets/alipay/alipay_public_key.pem  # 支付宝公钥（用于验签回调）
# ALIPAY_SIGN_TYPE=RSA2
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do  # 沙箱改 https://openapi.alipaydev.com/gateway.do

# ── 履约自动化 ───────────────────────────────────────────
# true: 订单 PAID 自动排队 worker 出票 / 酒店预订 / 签证申请
# false: 运营手动在 admin 里推进每个任务
ENABLE_AUTO_FULFILLMENT=true
