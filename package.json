{
  "name": "flight-ticket-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Flight Ticket Manager monorepo (sales-web, miniprogram, admin-web, backend, ml-pricing, infra)",
  "workspaces": [
    "backend",
    "sales-web",
    "admin-web",
    "miniprogram"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=sales-web",
    "dev:admin": "npm run dev --workspace=admin-web",
    "dev:mp": "npm run dev:weapp --workspace=miniprogram",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres redis",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:seed": "npm run prisma:seed --workspace=backend",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
