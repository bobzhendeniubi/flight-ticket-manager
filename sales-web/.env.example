# 世途旅行 sales-web · 环境变量模板
#
# 使用：cp .env.example .env.local && 按需修改
# Vite 只暴露 VITE_ 前缀的变量给浏览器。

# ── 后端 API 基础 URL（浏览器运行时用，构建时注入）──
# 开发保留默认 /api，走 vite-dev 反代；生产按部署拓扑填：
#   同域反代：VITE_API_BASE=/api
#   独立 API 域名：VITE_API_BASE=https://api.citur.com
VITE_API_BASE=/api

# ── 开发期 vite-dev 代理目标（只影响 npm run dev）──
# 默认 http://localhost:4000；联调 staging 后端时改成 https://staging-api.citur.com
VITE_DEV_API_TARGET=http://localhost:4000

# ── 开发期 vite 端口 ──
VITE_DEV_PORT=5173
