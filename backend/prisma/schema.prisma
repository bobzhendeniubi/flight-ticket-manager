// Flight Ticket Manager — Prisma schema
// Covers M1 issue #1: PostgreSQL multi-schema design (Redis/OpenSearch handled at app layer).
// All ids are cuid() strings; timestamps are UTC; monetary amounts are Decimal(12, 2) CNY.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  AGENT
  STAFF
  ADMIN
}

enum DocumentType {
  ID_CARD // 居民身份证
  PASSPORT
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

// 航司提交格式需要：M/F；X 留给非常规护照
enum Gender {
  M
  F
  X
}

// 操作部待办状态机
enum ReminderStatus {
  OPEN // 新建待处理
  IN_PROGRESS // 已认领处理中
  DONE // 完成
  SKIPPED // 不处理（含原因）
}

enum ReminderPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL // 签证截止/航班延误等
}

// 内部岗位（A20 岗位细分，2026-07-20 拍板「全改」）：STAFF 的子角色。
// null = 通用运营（全模板可导）；专岗账号导出被强制裁到本岗模板，不再信 query 参数。
enum StaffRole {
  VISA_DESK // 签证岗
  TICKETING // 票务岗
  ROOM_CONTROL // 房控岗
  FINANCE // 财务岗（财务页 + 经营报表；导出不裁剪，等同通用）
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String? // null for WeChat-only users
  role          UserRole  @default(CUSTOMER)
  // 内部岗位（仅 role=STAFF 有意义；ADMIN/AGENT/CUSTOMER 恒 null）
  staffRole     StaffRole?
  displayName   String?
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  wechatOpenId  String?   @unique
  wechatUnionId String?   @unique
  lastLoginAt   DateTime?
  /// 账号停用时间；非 null = 已停用（登录/刷新/每请求校验全拦截）。用于封存测试账号与离职回收。
  disabledAt         DateTime?
  /// 首登强制改密：管理员开户/重置密码后置 true，自助改密成功后清 false。
  mustChangePassword Boolean   @default(false)
  /// 会话版本号；改密、重置密码或停用账号时递增，让存量 access/refresh token 立即失效。
  authVersion        Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens    RefreshToken[]
  savedPassengers  SavedPassenger[]
  orders           Order[]               @relation("OrderUser")
  claimedOrders    Order[]               @relation("OrderClaimedBy")
  agentProfile     Agent?
  orderEvents      OrderStatusEvent[]
  customerProfile  CustomerProfile?
  auditLogs        AuditLog[]
  remindersCreated OperationalReminder[] @relation("ReminderCreator")
  remindersClaimed OperationalReminder[] @relation("ReminderClaimedBy")
  marketingPosters MarketingPoster[]     @relation("MarketingPosterCreator")
  seatLocks        SeatLock[]
  seatWaitlists    SeatWaitlist[]

  @@index([role])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256 of the refresh token
  authVersion Int     @default(0) // 签发时绑定 User.authVersion；账号生命周期变更后拒绝刷新
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SavedPassenger {
  id             String        @id @default(cuid())
  userId         String
  fullName       String
  documentType   DocumentType
  documentNumber String
  dateOfBirth    DateTime
  nationality    String // ISO 3166-1 alpha-2 (e.g., CN, US)
  passengerType  PassengerType @default(ADULT)
  phone          String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, documentNumber])
  @@index([userId])
  @@index([fullName])
  @@index([dateOfBirth])
}

// ─────────────────────────────────────────────────────────────────────────────
// Traveler Profile — 常旅客画像（按证件号聚合全量订单乘机人；travelerNo=常旅客号）
// ─────────────────────────────────────────────────────────────────────────────
model TravelerProfile {
  id              String       @id @default(cuid())
  documentType    DocumentType
  documentNumber  String
  fullName        String
  chineseName     String?
  gender          Gender?
  dateOfBirth     DateTime?
  nationality     String?
  passportExpiry  DateTime?    @db.Date
  tripCount       Int          @default(0)
  /// 在订未飞：有去程航班且尚未起飞的有效订单数（快照，与 tripCount 同一条重算链路回写）
  pendingTripCount Int         @default(0)
  orderCount      Int          @default(0)
  firstTripAt     DateTime?
  lastTripAt      DateTime?
  nextTripAt      DateTime?
  totalSpendCny   Decimal      @default(0) @db.Decimal(12, 2)
  prefCabin       CabinClass?
  prefBed         String?
  prefMeal        String?
  prefSingleRoom  Boolean      @default(false)
  needsWheelchair Boolean      @default(false)
  hotelHistory    Json         @default("[]")
  companions      Json         @default("[]")
  linkedUserId    String?
  notes           String?
  travelerNo      Int          @unique @default(autoincrement())
  mergedIntoId    String?
  refreshedAt     DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  redemptions TravelerBenefitRedemption[]

  @@unique([documentType, documentNumber])
  @@index([fullName])
  @@index([lastTripAt])
  @@index([tripCount])
  @@index([mergedIntoId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 常旅客权益核销台账 —— append-only 流水，永不删改。
//   可用次数 = TravelerProfile.tripCount（已飞）− 本档案流水 sum(tripsUsed)
//   tripsUsed > 0  核销（扣减可用次数）
//   tripsUsed < 0  冲正（补回；reversalOfId 指向被冲正的核销条目，一条最多冲正一次）
// 纯台账记录，不参与任何订单金额 / 定价 / 结算路径。
// ─────────────────────────────────────────────────────────────────────────────
model TravelerBenefitRedemption {
  id            String   @id @default(cuid())
  profileId     String
  tripsUsed     Int
  benefit       String
  note          String?
  reversalOfId  String?  @unique
  createdById   String
  /// 操作人姓名快照：账号改名/停用后台账仍可读
  createdByName String
  createdAt     DateTime @default(now())

  profile    TravelerProfile            @relation(fields: [profileId], references: [id])
  reversalOf TravelerBenefitRedemption? @relation("BenefitReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy TravelerBenefitRedemption? @relation("BenefitReversal")

  @@index([profileId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Customer Profile — 客户画像（User.role=CUSTOMER 的扩展信息）
// ─────────────────────────────────────────────────────────────────────────────
model CustomerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  idNumber       String? // 身份证/护照号
  primaryAgentId String? // 归属代理（null = 直销散客）
  tags           String[] // ["VIP", "回头客", "蜜月"]
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryAgent Agent? @relation(fields: [primaryAgentId], references: [id])

  @@index([primaryAgentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit Log — 全站敏感操作留痕
// ─────────────────────────────────────────────────────────────────────────────
enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AuditTargetType {
  AGENT
  ORDER
  FLIGHT
  CUSTOMER
  TRAVELER
  PRICING
  COMMISSION
  SETTLEMENT
  PRODUCT
  AUTH
  MARKETING
  SYSTEM
}

model AuditLog {
  id          String          @id @default(cuid())
  actorUserId String? // null = 系统操作（定时任务等）
  actorLabel  String? // 缓存的 email/displayName（防用户删除后丢信息）
  actorRole   String?
  action      String // CREATE_AGENT / UPDATE_PRICING / ADVANCE_ORDER_STATUS ...
  targetType  AuditTargetType
  targetId    String?
  targetLabel String? // 人类可读的对象名称
  before      Json?
  after       Json?
  severity    AuditSeverity   @default(INFO)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime        @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([severity])
}

// ─────────────────────────────────────────────────────────────────────────────
// Agents
// ─────────────────────────────────────────────────────────────────────────────

// 代理结算模式：逐单到账（每张订单都要见到钱才算清）/ 月结挂账（月底统一对账，单张订单不催款）
enum SettlementMode {
  PER_ORDER // 逐单到账
  MONTHLY // 月结挂账
}

model Agent {
  id                String         @id @default(cuid())
  userId            String         @unique
  companyName       String?
  contactName       String
  contactPhone      String
  prepaymentBalance Decimal        @default(0) @db.Decimal(14, 2) // CNY；不允许为负（不许赊账——扣减路径一律先校验余额，欠款走「认款→到账→再抵」）
  // 结算模式：PER_ORDER（默认，逐单见钱）/ MONTHLY（月结代理，单张订单挂账不催款，月底统一对账）
  settlementMode    SettlementMode @default(PER_ORDER)
  isActive          Boolean        @default(true)
  notes             String?
  // 代理层级 — 1 级代理 parentAgentId = null；上级创建下级时 tier = parent.tier + 1
  parentAgentId     String?
  tier              Int            @default(1)
  // 名单格式绑定（批量创单防呆）：该代理惯用的粘贴名单格式；NULL = 未登记，不参与格式校验。
  // 取值三选一（字符串常量，中性描述名）：
  //   COLON_MULTILINE_YMD  冒号多行 · 日期年-月-日
  //   INLINE_NUMBERED      编号单行空格式
  //   COLON_MULTILINE_DMY  冒号多行 · 日期日-月-年
  rosterFormat      String?
  // 识别词条：粘贴名单文本中扫到词条即提示/预填归属；保存时做全局查重（一词只归一家）。
  rosterKeywords    String[]       @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentAgent            Agent?                  @relation("AgentHierarchy", fields: [parentAgentId], references: [id])
  childAgents            Agent[]                 @relation("AgentHierarchy")
  prepaymentTransactions PrepaymentTransaction[]
  rechargeRequests       AgentRechargeRequest[]
  paymentChannels        PaymentChannel[]
  commissionRules        CommissionRule[]
  commissionRecords      CommissionRecord[]
  settlements            Settlement[]
  orders                 Order[]
  customers              CustomerProfile[]
  seatAllocations        SeatAllocation[]
  holdOrders             HoldOrder[]
  settlementDiscountRules SettlementDiscountRule[]

  @@index([isActive])
  @@index([parentAgentId])
  @@index([tier])
}

enum PrepaymentTxType {
  TOP_UP
  OFFSET // used on an order
  ADJUSTMENT // admin manual adjustment
  REFUND // returned from a cancelled order
}

model PrepaymentTransaction {
  id           String           @id @default(cuid())
  agentId      String
  amount       Decimal          @db.Decimal(14, 2) // positive = credit, negative = debit
  balanceAfter Decimal          @db.Decimal(14, 2)
  type         PrepaymentTxType
  orderId      String? // set when tied to an order
  description  String?
  createdById  String // user id of the admin/agent/system actor
  createdAt    DateTime         @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([orderId])
}

// 代理认款（充值申请）状态。
enum AgentRechargeStatus {
  PENDING // 待财务审核
  CONFIRMED // 已确认到账（已生成 TOP_UP 预存流水并加余额）
  REJECTED // 已驳回（不入账）
}

// 代理认款通道：代理上传付款凭证 + 申报金额 → 财务核实到账后确认 →
// 原子生成 PrepaymentTransaction(TOP_UP) 并加 prepaymentBalance。
// 余额只能这样充进来，不许赊账（prepaymentBalance 永不为负）；
// 订单尾款用「代理余额抵」从余额扣，凭证与订单不再逐张配对（多单混付由余额池消化）。
model AgentRechargeRequest {
  id                 String              @id @default(cuid())
  agentId            String
  // 代理申报金额（CNY）
  amountCny          Decimal             @db.Decimal(14, 2)
  // 财务核实的实际到账金额（确认时可修正；NULL = 按申报金额入账）
  confirmedAmountCny Decimal?            @db.Decimal(14, 2)
  // 付款凭证截图（data URL；张数/单张大小由服务端校验，受全局 bodyLimit 约束）
  proofImages        String[]
  note               String? // 代理备注（如「7/1 两笔货款合并」）
  status             AgentRechargeStatus @default(PENDING)
  reviewNote         String? // 财务审核备注 / 驳回原因
  submittedByUserId  String // 提交人 user id（代理账号）
  reviewedByUserId   String? // 审核人 user id（财务/管理员）
  reviewedAt         DateTime?
  // 确认入账生成的预存流水 id（幂等锚点：一张认款单最多入账一次）
  prepaymentTxId     String?             @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([agentId, createdAt])
}

// 返佣计提的产品维度（仅 CommissionRule / CommissionRecord 使用）。
// BUNDLE 是**独立一档费率**，与 FLIGHT 并列、互不覆盖：套餐订单会拆成
// FLIGHT 行（机票收入，走 FLIGHT 档）+ BUNDLE 行（地面+加项收入，走 BUNDLE 档），
// 两者金额相加即全包价，所以同时计提不构成重复计佣。
enum ProductKind {
  FLIGHT
  HOTEL
  TRANSFER
  VISA
  BUNDLE
}

model CommissionRule {
  id            String      @id @default(cuid())
  agentId       String
  productKind   ProductKind
  // commission rate as a decimal fraction, e.g. 0.0500 = 5.00%
  rate          Decimal     @db.Decimal(6, 4)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, productKind, effectiveFrom])
  @@index([agentId])
}

enum CommissionStatus {
  ACCRUED
  SETTLEMENT_REQUESTED
  SETTLED
  REVERSED
}

model CommissionRecord {
  id           String           @id @default(cuid())
  agentId      String
  orderId      String
  productKind  ProductKind
  baseAmount   Decimal          @db.Decimal(12, 2) // the order item amount commission is computed on
  rate         Decimal          @db.Decimal(6, 4) // net rate (this_agent.rate - child.rate if in chain)
  amount       Decimal          @db.Decimal(12, 2) // baseAmount * rate
  status       CommissionStatus @default(ACCRUED)
  // 0=seller, 1=seller's parent, 2=grandparent ... 用于结算时计算 "commissionPaidToChildren"
  chainDepth   Int              @default(0)
  settlementId String? // nullable until included in a settlement
  settledAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  agent      Agent       @relation(fields: [agentId], references: [id])
  order      Order       @relation(fields: [orderId], references: [id])
  settlement Settlement? @relation(fields: [settlementId], references: [id])

  @@index([agentId, status])
  @@index([orderId])
  @@index([settlementId])
  // 结算热路径：按 (agentId, status, createdAt) 查本期 ACCRUED
  @@index([agentId, status, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Settlement — 月度结算单，每个代理每月 1 张
// ─────────────────────────────────────────────────────────────────────────────
enum SettlementStatus {
  DRAFT // 生成后的初始状态
  PENDING_APPROVAL // 提交审核
  APPROVED // 管理员核准，待支付
  PAID // 已支付给代理（CommissionRecord → SETTLED，prepaymentOffset 已扣）
  VOIDED // 作废（比如重算）
}

model Settlement {
  id                       String           @id @default(cuid())
  period                   String // YYYY-MM
  agentId                  String
  orderCount               Int              @default(0)
  grossRevenue             Decimal          @default(0) @db.Decimal(14, 2)
  commissionEarned         Decimal          @default(0) @db.Decimal(14, 2)
  commissionPaidToChildren Decimal          @default(0) @db.Decimal(14, 2)
  netCommission            Decimal          @default(0) @db.Decimal(14, 2)
  prepaymentOffset         Decimal          @default(0) @db.Decimal(14, 2)
  payableToAgent           Decimal          @default(0) @db.Decimal(14, 2)
  status                   SettlementStatus @default(DRAFT)
  generatedAt              DateTime         @default(now())
  approvedAt               DateTime?
  paidAt                   DateTime?
  notes                    String?
  updatedAt                DateTime         @updatedAt

  agent       Agent              @relation(fields: [agentId], references: [id])
  commissions CommissionRecord[]

  @@unique([period, agentId])
  @@index([period])
  @@index([status])
  @@index([agentId, period])
}

// ─────────────────────────────────────────────────────────────────────────────
// Products — Flights
// ─────────────────────────────────────────────────────────────────────────────

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

model Flight {
  id              String   @id @default(cuid())
  flightNumber    String // e.g., "CA1234"
  originCode      String // IATA code, e.g., "PEK"
  destinationCode String // IATA code
  originTerminal  String?
  destTerminal    String?
  aircraftType    String?
  isActive        Boolean  @default(true)
  // 升舱差价（¥/程/座）— 单一配置源：经济舱→商务舱每航段的加价。既供本航班「商务舱价格联动」
  // 派生商务舱现价（见 businessPriceLinked），也供「跟随航班」的套餐升舱计价取值（Bundle.businessUpgradeCnyPerLeg=null）。
  // 与航司同业表口径一致（升级商务舱 加 700/程；往返 700×2）。
  businessUpgradeCnyPerLeg Int @default(700)
  // 商务舱价格联动经济舱：开启后该航班所有班次的商务舱现价 = 该班次经济舱当前售价（含仓位阶梯现价）
  //   + businessUpgradeCnyPerLeg，商务舱自身 basePrice/fareBuckets 不再参与计价。
  // 关闭（默认）：行为与历史完全一致（商务舱按自身 basePrice/阶梯定价）。派生在单一计价点 PricingService.calculatePrice 注入。
  businessPriceLinked      Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schedules       FlightSchedule[]
  costPeriods     FlightCostPeriod[]
  baggagePolicies FlightBaggagePolicy[]
  // 套餐绑定的航班号（模板绑法：只绑航班号，不绑某天；买家选出发日再解析具体班次）
  outboundBundles Bundle[]              @relation("BundleOutboundFlight")
  returnBundles   Bundle[]              @relation("BundleReturnFlight")

  @@unique([flightNumber])
  @@index([originCode, destinationCode])
  marketingPosters MarketingPoster[]
}

// 行李规则 — 按 航班 × 舱等 配置（公斤 / 件数都可单独留空）
model FlightBaggagePolicy {
  id            String     @id @default(cuid())
  flightId      String
  cabin         CabinClass
  checkedKg     Int? // 托运额度（kg/人）
  checkedPieces Int? // 托运件数（件/人）
  carryOnKg     Int? // 手提额度（kg/人）
  note          String? // 补充说明（如"超件 ¥xx/件"）
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, cabin])
}

model FlightSchedule {
  id                 String   @id @default(cuid())
  flightId           String
  departureTime      DateTime // UTC
  arrivalTime        DateTime // UTC
  departureTz        String // IANA tz, e.g., "Asia/Shanghai"
  arrivalTz          String
  // 包机总成本（CNY）— 整班次付给航司的包机价；按"卖出座位 / 总成本"算单座分摊
  charterCostCny     Decimal? @db.Decimal(12, 2)
  // 包机成本汇率四元组（A2，2026-07-17 拍板：可空，审计留痕用）——
  // 财务口径：包机常以外币（USD/VND/MOP）实付，charterCostCny 只是人脑折算后的死数，
  // 复核时查不到「按哪天哪个汇率折的」。四字段把折算依据留下来；最终入账额仍以 CNY 字段为准。
  charterSourceCurrency String?  @db.VarChar(3) // ISO 4217，如 USD/VND/MOP
  charterSourceAmount   Decimal? @db.Decimal(14, 2) // 原币金额
  charterFxRate         Decimal? @db.Decimal(12, 6) // 折算汇率（原币→CNY）
  charterFxDate         DateTime? @db.Date // 折算/付款日
  // 机场税（CNY/人）— 出发地 / 目的地分开（岘港、澳门税率不同）
  airportTaxDepCny   Decimal? @db.Decimal(10, 2)
  airportTaxArrCny   Decimal? @db.Decimal(10, 2)
  // 财务追加成本（CNY/人；起降折扣可填负数代表减项）—— 都是 per-passenger
  fuelCostCny        Decimal? @db.Decimal(10, 2)
  peakSurchargeCny   Decimal? @db.Decimal(10, 2)
  aircraftAdjustCny  Decimal? @db.Decimal(10, 2)
  takeoffDiscountCny Decimal? @db.Decimal(10, 2)
  costLocked         Boolean  @default(false)
  costLockedAt       DateTime?
  costLockedBy       String?
  // 开票上限不再是本表上的独立字段：上限 = 该班次座位库存 = Σ FlightSeatClass.capacity
  //（多少商务舱 + 多少经济舱）。卖票与开票共用同一本账，见 ticketing-cap.ts。
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  flight          Flight            @relation(fields: [flightId], references: [id], onDelete: Cascade)
  seatClasses     FlightSeatClass[]
  orderItems      OrderItem[]
  pricingConfig   PricingConfig?
  seatLocks       SeatLock[]
  seatWaitlists   SeatWaitlist[]
  seatAllocations SeatAllocation[]
  holdOrders      HoldOrder[]

  @@index([flightId, departureTime])
  @@index([departureTime])
}

model FlightSeatClass {
  id          String     @id @default(cuid())
  scheduleId  String
  cabin       CabinClass
  capacity    Int // base capacity
  sold        Int        @default(0) // source of truth; Redis is cache
  basePrice   Decimal    @db.Decimal(10, 2) // CNY
  // 仓位阶梯（显式动态加价）：有序数组 [{ quota, price }]，最便宜的在前；售罄一档开下一档。
  // null / [] = 未配置阶梯 = 回退旧版 basePrice×日期倍率×余位倍率自动定价。
  fareBuckets Json? // [{ "quota": 20, "price": 1280 }, ...]（quota int≥1, price≥0）
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  schedule      FlightSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  seatLocks     SeatLock[]
  seatWaitlists SeatWaitlist[]
  holdOrders    HoldOrder[]

  @@unique([scheduleId, cabin])
}

// ─────────────────────────────────────────────────────────────────────────────
// Seat Locks — 锁位：下单前临时占座，到期自动释放（status 流转由应用层维护）
// ─────────────────────────────────────────────────────────────────────────────
enum SeatLockStatus {
  ACTIVE
  EXPIRED
  CONSUMED
  RELEASED
}

model SeatLock {
  id               String         @id @default(cuid())
  flightScheduleId String
  seatClassId      String
  userId           String
  qty              Int
  status           SeatLockStatus @default(ACTIVE)
  expiresAt        DateTime
  consumedOrderId  String? // 锁位被哪张订单消费（CONSUMED 时填）
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  flightSchedule FlightSchedule  @relation(fields: [flightScheduleId], references: [id], onDelete: Cascade)
  seatClass      FlightSeatClass @relation(fields: [seatClassId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([flightScheduleId, seatClassId, status])
  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// 切位（包位）— 从散客池里划出 N 座给某代理专卖；到期未售回散客池。
// 与锁位/已售的关系（散客池口径）：
//   散客池余票 = capacity − sold − ACTIVE 未过期锁位 − Σ(ACTIVE 切位 seats)
// 被切出的座位不是消失：代理仍可卖（走同一 FlightSeatClass.sold 扣减），只是不进散客池。
// ─────────────────────────────────────────────────────────────────────────────
enum SeatAllocationStatus {
  ACTIVE // 生效中，占用散客池
  RECLAIMED // 已回收（未售部分归还散客池）
}

model SeatAllocation {
  id                String               @id @default(cuid())
  flightScheduleId  String
  cabin             CabinClass // 定位到 FlightSeatClass（scheduleId + cabin 唯一）
  agentId           String
  seats             Int // 切给该代理的座位数
  unitPriceCny      Int? // 约定单价（选填；null=按常规售价）
  reclaimDaysBefore Int                  @default(7) // 出发前多少天回收未售部分
  status            SeatAllocationStatus @default(ACTIVE)
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  flightSchedule FlightSchedule @relation(fields: [flightScheduleId], references: [id], onDelete: Cascade)
  agent          Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([flightScheduleId, cabin, status])
  @@index([agentId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// 占位单（无名单库存实体）— 旅游团留位 / 代理切位 / 散客占位。
// 可售余量统一为：capacity − sold − 未过期 ACTIVE 锁位 − 占位余座。
// 维护库存占用、释放/取消、收款计划与减员清算；名单转正仍留待后续阶段。
// ─────────────────────────────────────────────────────────────────────────────
enum HoldOrderStatus {
  PENDING     // 建单未生效（二期切位模式全款才占座）
  HOLDING     // 占座中
  OVERDUE     // 有期款逾期仍占座（二期）
  FULLY_PAID  // 全款已收（二期）
  CONVERTED   // 已全部转正式订单（三期）
  RELEASED    // 运营释放，座位回池
  CANCELLED   // 客户取消，座位回池
}

enum HoldOwnerType {
  AGENT
  CUSTOMER
}

enum HoldInstallmentStatus {
  PENDING
  PAID
}

enum HoldAmountRule {
  PER_PERSON_FIXED
  REMAINDER
}

enum HoldOverdueAction {
  REMIND_ONLY
  AUTO_RELEASE
}

enum HoldOccupyOn {
  CREATE
  FULL_PAYMENT
}

model HoldOrder {
  id               String          @id @default(cuid())
  holdNo           String          @unique
  flightScheduleId String
  seatClassId      String
  ownerType        HoldOwnerType
  agentId          String?
  groupName        String?
  /// 团号：同一个团的多个航段（去程/回程/多段）共享一个团号，建单时统一生成。
  /// 单航段占位也会有团号，保证「按团查」永远能用一个口径查出全部航段。
  groupRef         String?
  seats            Int
  seatsConverted   Int             @default(0)
  seatsCancelled   Int             @default(0)
  perSeatPriceCny  Int
  freeCancelRatio  Decimal?        @db.Decimal(4, 3)
  freeCancelUsed   Int             @default(0)
  occupyOn         HoldOccupyOn    @default(CREATE)
  status           HoldOrderStatus @default(HOLDING)
  notes            String?
  createdById      String
  releasedAt       DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  flightSchedule FlightSchedule  @relation(fields: [flightScheduleId], references: [id], onDelete: Restrict)
  seatClass      FlightSeatClass @relation(fields: [seatClassId], references: [id], onDelete: Restrict)
  agent          Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)
  installments       HoldInstallment[]
  receiptAllocations HoldReceiptAllocation[]
  reductions         HoldReductionRecord[]
  conversions        HoldConversionRecord[]
  sourceOrders       Order[]              @relation("HoldSourceOrders")

  @@index([seatClassId, status])
  @@index([flightScheduleId, status])
  @@index([agentId, status])
  @@index([groupRef])
}

model HoldInstallment {
  id              String                @id @default(cuid())
  holdOrderId     String
  seq             Int
  label           String
  amountRule      HoldAmountRule
  perPersonCny    Int?
  amountCny       Int
  seatsBasis      Int
  dueDate         DateTime              @db.Date
  status          HoldInstallmentStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  holdOrder       HoldOrder             @relation(fields: [holdOrderId], references: [id], onDelete: Cascade)
  allocations     HoldReceiptAllocation[]

  @@unique([holdOrderId, seq])
  @@index([status, dueDate])
}

model HoldReceiptAllocation {
  id                String          @id @default(cuid())
  receiptId         String
  holdOrderId       String
  holdInstallmentId String
  amountCny         Decimal         @db.Decimal(14, 2)
  reversedAt        DateTime?
  createdById       String?
  createdAt         DateTime        @default(now())

  receipt         Receipt         @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  holdOrder       HoldOrder       @relation(fields: [holdOrderId], references: [id], onDelete: Cascade)
  holdInstallment HoldInstallment @relation(fields: [holdInstallmentId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([holdOrderId])
}

model HoldReductionRecord {
  id             String   @id @default(cuid())
  holdOrderId    String
  seatsReduced   Int
  freeSeats      Int
  forfeitSeats   Int
  perSeatPaidCny Int
  forfeitCny     Int
  creditCny      Int
  surplusCny     Int      @default(0)
  note           String?
  createdById    String
  createdAt      DateTime @default(now())

  holdOrder HoldOrder @relation(fields: [holdOrderId], references: [id], onDelete: Cascade)

  @@index([holdOrderId])
}

// 名单导入转正流水：一条记录对应一次从占位单消费若干座位并结转已收款。
// 订单是独立财务实体；占位单删改不会反向影响订单。
model HoldConversionRecord {
  id           String   @id @default(cuid())
  holdOrderId  String
  orderId      String
  seats        Int
  carryCny     Int
  paymentId    String?
  requestToken String
  createdById  String
  createdAt    DateTime @default(now())

  holdOrder HoldOrder @relation(fields: [holdOrderId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([holdOrderId])
  @@index([orderId])
  @@index([paymentId])
  @@unique([holdOrderId, requestToken])
}

// 拆单流水：一条记录对应一次「把选中乘客从源订单拆出成新订单」（学航司 split PNR 的售后逃生门）。
// snapshot 存拆单当刻的每人份额 rows[] 全量快照，事后复算/对账依据。
// (sourceOrderId, requestToken) 唯一 = 执行端点的幂等键：同 token 重试只回放既有结果。
model OrderSplitRecord {
  id             String   @id @default(cuid())
  sourceOrderId  String
  targetOrderId  String
  passengerCount Int
  movedShareCny  Decimal  @db.Decimal(12, 2)
  movedPaidCny   Decimal  @db.Decimal(12, 2)
  snapshot       Json // 每人份额 rows[] 全量快照，事后复算依据
  requestToken   String
  createdById    String
  createdAt      DateTime @default(now())

  sourceOrder Order @relation("SplitSource", fields: [sourceOrderId], references: [id], onDelete: Restrict)
  targetOrder Order @relation("SplitTarget", fields: [targetOrderId], references: [id], onDelete: Restrict)

  @@unique([sourceOrderId, requestToken])
  @@index([sourceOrderId])
  @@index([targetOrderId])
}

model HoldOrderConfig {
  id                     String            @id @default(cuid())
  installments           Json
  overdueAction          HoldOverdueAction @default(REMIND_ONLY)
  defaultFreeCancelRatio Decimal           @db.Decimal(4, 3) @default(0.1)
  updatedAt              DateTime          @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// 候补 — 舱位售罄/余票不足时登记；座位释放后 worker 按先来先到标 NOTIFIED
// ─────────────────────────────────────────────────────────────────────────────
enum WaitlistStatus {
  ACTIVE
  NOTIFIED
  FULFILLED
  CANCELLED
}

model SeatWaitlist {
  id               String         @id @default(cuid())
  flightScheduleId String
  seatClassId      String
  userId           String
  qty              Int
  contactPhone     String
  status           WaitlistStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  flightSchedule FlightSchedule  @relation(fields: [flightScheduleId], references: [id], onDelete: Cascade)
  seatClass      FlightSeatClass @relation(fields: [seatClassId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([flightScheduleId, seatClassId, status])
  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// 航班成本周期 — 按 (航班, 日期段) 定包机/机场税；班次的 charterCostCny 等字段
// 仍存在并作为"单班次 override"优先生效（resolution: schedule ?? period ?? null）
// ─────────────────────────────────────────────────────────────────────────────
model FlightCostPeriod {
  id                 String   @id @default(cuid())
  flightId           String
  // 周期生效起止日（date-only；按航班出发地时区匹配班次日期）
  effectiveFrom      DateTime @db.Date
  effectiveTo        DateTime @db.Date
  // 周期默认成本（CNY；任一为 null 表示该字段不通过 period 提供，由班次 override 或留空）
  charterCostCny     Decimal? @db.Decimal(12, 2)
  // 包机成本汇率四元组（A2；同 FlightSchedule，可空审计留痕）
  charterSourceCurrency String?  @db.VarChar(3)
  charterSourceAmount   Decimal? @db.Decimal(14, 2)
  charterFxRate         Decimal? @db.Decimal(12, 6)
  charterFxDate         DateTime? @db.Date
  airportTaxDepCny   Decimal? @db.Decimal(10, 2)
  airportTaxArrCny   Decimal? @db.Decimal(10, 2)
  // 财务追加成本（per-pax CNY；同 FlightSchedule）
  fuelCostCny        Decimal? @db.Decimal(10, 2)
  peakSurchargeCny   Decimal? @db.Decimal(10, 2)
  aircraftAdjustCny  Decimal? @db.Decimal(10, 2)
  takeoffDiscountCny Decimal? @db.Decimal(10, 2)
  note               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId, effectiveFrom, effectiveTo])
}

// ─────────────────────────────────────────────────────────────────────────────
// Products — Hotels
// ─────────────────────────────────────────────────────────────────────────────

model Hotel {
  id          String   @id @default(cuid())
  // 产品编号（H0001、H0002...）— 运营/财务对账用；老数据迁移时按 createdAt 回填
  code        String?  @unique
  name        String
  nameEn      String?
  cityCode    String // IATA or internal city code
  area        String? // 区域描述（如"美溪海滩"）
  address     String
  starRating  Int // 1..5
  // 国际五星标记（与结算价日历 SettlementTier.INTL_5STAR「国际五星」对齐口径）：
  // starRating 仍是纯 1..5 整数语义不变；国际五星 = starRating=5 且本标记为 true。
  // 不参与 hotel-control 随机池分类（RANDOM_STAR_TIERS 只按 3/4 星分池，不受影响）。
  intlFiveStar Boolean @default(false)
  // 星级随机档的「占位酒店」标记（3/4/5 = 该占位酒店代表哪个随机档；NULL = 真实酒店）。
  //
  // 历史包袱：随机档最早是靠建几家假酒店（「随机三星」「随机四星」…）承载的 —— 套餐绑它们的房型、
  // 订单行落在它们的房型上。随机档改为「同星级真酒店的派生聚合」后，这些假酒店若被当成真酒店参与
  // 合计，同一批房就会被算两遍，销控板上还会既出现酒店组又出现聚合组的同名两行。
  //
  // 因此打上本标记的酒店在房控口径里一律「不是酒店」：
  //   · 不进 Σ真酒店余量（与 intlFiveStar 的排除并列）；
  //   · 名下的切房周期不计入任何余量（照存量池周期同款「已停用」处理，也不许新建）；
  //   · 落在它房型上的订单行 = **未落位**占用，计入对应档次聚合组的「用房（未落位）」。
  // 落位 = 走换酒店流程把房型换到真酒店（占用从「未落位」转到该酒店，聚合合计不变）。
  //
  // 判定一律看本列，**绝不按酒店名字匹配**。存量数据由运维在部署时按 id 回填。
  randomTierPlaceholder Int?
  // 指定酒店加价（CNY/人）：套餐按「星级随机」报价，客人点名要住本酒店时按占座人数加收的
  // 每人差价（业务口径：同业报价基础上按指定酒店加收，各酒店差价不同，运营各配各的）。
  // 0 = 本酒店指定不加价。仅套餐录单「指定酒店」路径读取；单独 HOTEL 行按房型价成交，不叠加。
  designationSurchargeCnyPerPerson Int @default(0)
  basePrice   Decimal? @db.Decimal(10, 2) // 起步价（展示用）
  rating      Decimal? @db.Decimal(3, 2) // 客户评分 0-5（兜底展示；真实评分由 Review 聚合覆盖）
  reviewCount Int?
  soldCount   Int      @default(0) // 已售份数（展示用，seed 填充）
  emoji       String?
  highlight   String? // 一句话卖点
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  amenities   String[] // e.g., ["wifi", "breakfast", "pool"]
  photos      String[] // S3 URLs
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roomTypes    HotelRoomType[]
  blockPeriods HotelBlockPeriod[]

  @@index([cityCode])
}

// ─────────────────────────────────────────────────────────────────────────────
// 酒店包房周期 — 按日期段向酒店切房（buy-out blocks）；dateFrom/dateTo 闭区间
//
// 两种周期，二选一（应用层强制 XOR，见 hotel-control.service.ts createBlockPeriod）：
//   ① 具体酒店周期：hotelId 非空、randomStarTier 为空 —— 原有语义，切某家酒店的房。
//   ② 星级随机池周期：hotelId 为空、randomStarTier=3|4 —— 卖「三星/四星随机」套餐用的
//      真库存池：先按星级切总量，客人下单只占池，之后房控再把这单落到具体酒店（换酒店）。
//      池与具体酒店**互不扣减**：选明月扣明月，选随机扣池；落地时占用从池转到该酒店。
//      酒店的星级分类直接取 Hotel.starRating（不另建分类表）。
// ─────────────────────────────────────────────────────────────────────────────
model HotelBlockPeriod {
  id String @id @default(cuid())
  // NULL = 星级随机池周期（此时 randomStarTier 非空）
  hotelId String?
  // 星级随机池档次（3=三星随机、4=四星随机）；NULL = 具体酒店周期
  randomStarTier Int?
  dateFrom       DateTime @db.Date
  dateTo         DateTime @db.Date // inclusive
  rooms          Int
  unitPrice      Decimal? @db.Decimal(12, 2) // 切房单价（CNY/间/晚）
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hotel Hotel? @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, dateFrom, dateTo])
  @@index([randomStarTier, dateFrom, dateTo])
}

model HotelRoomType {
  id              String   @id @default(cuid())
  hotelId         String
  name            String // e.g., "Deluxe King"
  bedType         String? // "1 张大床 · 海景"
  capacity        Int // max guests（总人数上限；保留作为整体容量）
  // 单间可坐几大人 / 几小孩（每个酒店房型可 fit 几大人/几小孩）。
  // 套餐下单时据此算 roomsNeeded = max(ceil(成人/maxAdults), ceil(儿童/maxChildren), 1)，
  // 房间数 >1 时套餐酒店部分按房价 ×roomsNeeded 收费（自动加房收钱）。婴儿不占床。
  maxAdults       Int      @default(2)
  maxChildren     Int      @default(1)
  basePrice       Decimal  @db.Decimal(10, 2)
  // 净房价（CNY/晚）— 付给酒店的真实成本；NULL 时按 basePrice × 0.70 估算
  costPriceCny    Decimal? @db.Decimal(10, 2)
  priceMultiplier Decimal? @db.Decimal(5, 2) // 相对 hotel.basePrice 的倍率（可选，用于 UI 快速报价）
  photos          String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel      Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  inventory  HotelRoomInventory[]
  orderItems OrderItem[]
  bundles    Bundle[]

  @@unique([hotelId, name])
}

model HotelRoomInventory {
  id         String   @id @default(cuid())
  roomTypeId String
  date       DateTime @db.Date
  available  Int
  price      Decimal  @db.Decimal(10, 2) // may override basePrice for this date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roomType HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Products — Transfers & Visas
// ─────────────────────────────────────────────────────────────────────────────

model Transfer {
  id           String   @id @default(cuid())
  // 产品编号（T0001、T0002...）
  code         String?  @unique
  name         String
  vehicleType  String // e.g., "sedan", "suv", "van"
  capacity     Int
  originArea   String
  destArea     String
  basePrice    Decimal  @db.Decimal(10, 2)
  // 司机/车队结算价（CNY）— NULL 时按 basePrice × 0.65 估算
  costPriceCny Decimal? @db.Decimal(10, 2)
  features     String[] // e.g., ["中文司机", "免费等候 60 分钟"]
  duration     String? // "约 15 分钟"
  soldCount    Int      @default(0) // 已售份数（展示用，seed 填充）
  emoji        String?
  photo        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems OrderItem[]
}

// 签证签发方式（产品结构化分类，替代靠产品名正则猜测）
enum VisaIssuanceMethod {
  E_VISA // 电子签
  STICKER // 贴纸签
  ARRIVAL // 落地签
  OTHER
}

// 签证入境次数
enum VisaEntryType {
  SINGLE // 单次
  MULTIPLE // 多次
}

// 乘客送签进度（按人送签用）——语义与签证台现用任务状态逐字对齐，
// 成员名取自 FulfillmentStatus 的签证进度子集，使「乘客→任务」派生成为恒等映射：
//   PENDING     待处理（新录入待送签）
//   IN_PROGRESS 已送签材料准备
//   CONFIRMED   已送签
// 「已签证/出签」不设独立成员：任务级 FulfillmentStatus 无对应态，出签事实由
// Passenger.visaIssueDate / visaExpiry 记录；若在此再加一态会让派生口径无处落，
// 故按最小改动只覆盖三档送签进度（复核点：是否需要独立「已签证」态）。
enum VisaSubmissionStatus {
  PENDING
  IN_PROGRESS
  CONFIRMED
}

model Visa {
  id                 String              @id @default(cuid())
  // 产品编号（V0001、V0002...）
  code               String?             @unique
  destinationCountry String // ISO 3166-1 alpha-2 (e.g., "VN")
  country            String? // 中文国名（"越南"）
  visaType           String // e.g., "tourist", "business"
  visaName           String? // 完整签证名称（"电子签证 E-visa · 30 天单次"）
  // 签发方式（电子签/贴纸签/落地签/其他）；未设置 = null，签证台徽章按此展示，缺失时回退旧的产品名正则猜测
  issuanceMethod     VisaIssuanceMethod?
  // 入境次数（单次/多次）；未设置 = null
  entryType          VisaEntryType?
  flag               String? // emoji flag
  photo              String? // 卡片展示图（URL）
  processingDays     Int
  basePrice          Decimal             @db.Decimal(10, 2)
  // 旧的单值加急费（保留不动，老数据/未配分档的产品仍按它计价与展示）
  expressSurcharge   Decimal?            @db.Decimal(10, 2)
  // 加急分档（运营自配）：[{ label: "一工", workDays: 1, surchargeCny: 100 }, ...]
  // 不同加急等级出签天数不同、加价不同。[] = 未配分档 → 回落 expressSurcharge 单值口径。
  // 定价只认这里的 surchargeCny（服务端按档名查表加价，客户端只传档名不传金额）。
  expressTiers       Json                @default("[]")
  // 使馆/代办成本（CNY）— NULL 时按 basePrice × 0.55 估算（签证毛利通常更高）
  costPriceCny       Decimal?            @db.Decimal(10, 2)
  validityMonths     Int? // 签证有效期（月）
  stayDays           Int? // 单次入境最多可停留天数（订单详情「最多可停留 X 天」展示用）
  highlight          String? // "最热销 · 全流程线上"
  requiredDocs       String[] // e.g., ["passport_scan", "photo", "itinerary"]
  // 签证公司/代办渠道名（财务对账用——核对某笔签证金额属于哪家供应商的账单）
  supplier           String?
  soldCount          Int                 @default(0) // 已售份数（展示用，seed 填充）
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  orderItems OrderItem[]
}

// ─────────────────────────────────────────────────────────────────────────────
// 结算价日历 — 运营按「出发日期 × 晚数 × 酒店档次」维护的同业结算价（每人 CNY）。
// 代理下套餐单时按去程出发日期 + 套餐配置的档次/晚数自动取价（服务端权威定价）。
// 商务舱升舱差价由航班级联动另行解决，不在本表；本表只管地面档次 × 晚数的整包每人价。
// ─────────────────────────────────────────────────────────────────────────────
enum SettlementTier {
  CITY_3STAR // 市区三星
  CITY_4STAR // 市区四星
  CITY_5STAR // 市区五星
  INTL_5STAR // 国际五星
}

model SettlementRate {
  id                String         @id @default(cuid())
  tier              SettlementTier
  nights            Int // 住宿晚数（1–5）
  departDate        DateTime       @db.Date // 去程出发日期（date-only）
  pricePerPersonCny Int // 每人结算价（CNY，整数）
  // 扩展点：当前单一航线（澳门-岘港），note 可记航线/备注；未来按航线区分时再拆列。
  note              String?
  updatedBy         String? // 最近更新人 userId（审计冗余，展示"谁改的"）
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([tier, nights, departDate])
  @@index([departDate])
}

// 结算价立减规则 — 在结算价日历基础上的固定立减（¥/人）。三类互相独立：
//   AGENT         指定代理专属（agentId 必填）
//   AGENT_DEFAULT 未配置专属规则的代理兜底
//   RETAIL        前台散客（与套餐 discountPct 叠加）
enum SettlementDiscountKind {
  AGENT
  AGENT_DEFAULT
  RETAIL
}

model SettlementDiscountRule {
  id                   String                  @id @default(cuid())
  kind                 SettlementDiscountKind
  agentId              String? // kind=AGENT 必填；其余必须为 null（服务端校验）
  tier                 SettlementTier
  nights               Int
  startDate            DateTime                @db.Date // 出发日窗口（含）
  endDate              DateTime                @db.Date // 出发日窗口（含）
  discountPerPersonCny Int // ¥/人，> 0
  isActive             Boolean                 @default(true)
  note                 String?
  updatedBy            String? // 操作者 user id（沿用 SettlementRate 惯例）
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([kind, agentId, tier, nights, startDate])
  @@index([agentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 机票结算价日历 — 运营按「航班号 × 出发日期」维护的同业结算价（每人 CNY）。
// 对应运营的机票报价表：行 = 日期，列 = 航班（去程 / 回程各一列），每格一个 OTA 结算价/人。
// 代理下**纯机票单**时按每条航段的班次航班号 + 出发地本地日自动取价（服务端权威定价）。
// 与 SettlementRate（地面整包价：档次 × 晚数）互不重叠：那张管地面，这张管机票航段。
// ─────────────────────────────────────────────────────────────────────────────
model FlightSettlementRate {
  id                String   @id @default(cuid())
  flightNumber      String // 航班号（如 QH9589）；不引外键——报价表可先于航班建档维护
  departDate        DateTime @db.Date // 出发地本地出发日（date-only）
  pricePerPersonCny Int // 每人结算价（CNY，整数）
  note              String?
  updatedBy         String? // 最近更新人 userId（审计冗余，展示"谁改的"）
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([flightNumber, departDate])
  @@index([departDate])
}

/// 美金汇率表（按「生效日」维护）——财务加一条「某日起 x.xx」，区间由下一条的生效日隐含，
/// 因此天然无空洞、无重叠。取数口径 = 「生效日 ≤ 目标日期的最新一条」，无更早记录则取不到。
/// 折算结果**当场固化**在业务单据上（如签证任务的 visaFxRate / visaUnitCostCny），
/// 之后改这张表**绝不追溯**已折算的旧单据。
model UsdFxRate {
  id            String   @id @default(cuid())
  effectiveFrom DateTime @unique @db.Date // 生效日（date-only）；同一天只允许一条，upsert 幂等键
  rate          Decimal  @db.Decimal(12, 6) // USD→CNY 汇率（正数）
  note          String?
  updatedBy     String? // 最近更新人 userId（审计冗余，展示"谁改的"）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Products — Bundles (打包套餐)
// ─────────────────────────────────────────────────────────────────────────────
model Bundle {
  id                            String   @id @default(cuid())
  // 产品编号（B0001、B0002...）
  code                          String?  @unique
  name                          String
  tagline                       String?
  // 服务内容（订单详情 / 前台展示的服务说明，运营在套餐向导里填，每行一条，
  // 如「中文客服，越南当地机场助签」「举牌接机，送至酒店并协助分房」）
  serviceNotes                  String?  @db.Text
  // 每人操作费（CNY，整数，运营在套餐向导里可改，默认 ¥20）—— 计入起价/人，下单按出行人头收，
  // 是买家实付的一部分（卖价侧）。注意：与 OrderCostItem.OPERATION_FEE /
  // OPERATION_FEE_CNY_PER_ORDER（每单固定 ¥20，财务成本口径，订单创建自动计提）是两个完全独立的
  // 概念——那个是成本侧、按单、系统固定，这个是卖价侧、按人、套餐可配置。两者恰好同名「操作费」，
  // 互不影响、互不派生，不要合并读写。
  operationFeeCny               Int      @default(20)
  emoji                         String?
  photo                         String?
  // 套餐组件列表（JSON）: [{kind: 'HOTEL', productName, qty, unitPrice}, ...]
  // 注意：FLIGHT 组件的 unitPrice=0，客户端选日期后调 /flights/price 实时取价
  items                         Json
  flightPax                     Int      @default(1) // 机票组件含多少人
  // 套餐折扣（百分比，0–100）：整个全包价(实时机票+地面+加项) × (1 − discountPct/100)。
  // 这是套餐唯一的折扣口径，随出发日自动浮动（机票实时）。运营只填这一个数。
  discountPct                   Int      @default(0)
  // [已弃用] 旧的固定 CNY 让利；被 discountPct 取代，新逻辑不再读取（列暂留，避免破坏性迁移）。
  groundDiscount                Decimal  @default(0) @db.Decimal(10, 2)
  suitableFor                   String? // "2 人 · 情侣/家庭"
  // 套餐关联酒店房型 — 下单时把房型+入住日期盖到订单行上，房控板自动计入套餐占房
  hotelRoomTypeId               String?
  hotelNights                   Int? // 默认入住晚数（客户没填回程日期时按 goDate + hotelNights 推 checkOut）
  // 套餐绑定的去程 / 回程航班号（模板绑法：只绑航班号，不绑某天）。
  // 买家选出发日后按该航班号 + 本地出发日解析出具体班次（一个航班号一天只有一班）。
  // onDelete SetNull：删航班不删套餐，只解除绑定。
  outboundFlightId              String?
  returnFlightId                String?
  // 可选升级加价（CNY，按产品可配置；运营在后台改）— 都是 server-priced add-on：
  //   singleSupplementCnyPerNight = 一个人住酒店（单人入住）/晚 的房差，运营默认 ¥80
  //   businessUpgradeCnyPerLeg    = 升舱商务 /航段 的加价（¥/程/座）
  // 注意：豪华/五星套餐（洲际半岛、四季）的单人入住房差远高于平价默认值，故 seed 里按产品上调。
  singleSupplementCnyPerNight   Int      @default(80)
  // 升舱差价（¥/程/座）：null = 「跟随航班」——升舱计价时按该套餐绑定航班的 Flight.businessUpgradeCnyPerLeg 取值
  //   （一处配置、两处生效；运营留空即随航班浮动）；非 null = 套餐自有覆盖（含 0 = 显式不提供升舱）。
  //   存量数据保持原值（多为 700 或 0）不迁移，行为不变。
  businessUpgradeCnyPerLeg      Int?
  // 占座儿童 / 不占座婴儿定价（按产品可配置；运营在后台改）：
  //   childSeatDiscountCnyPerPerson = 占座儿童比成人每人便宜多少 CNY（运营默认 ¥30，可改）
  //   infantPriceCny                = 不占座婴儿每人价 CNY（默认免费 0，可改）
  // 占座儿童与成人同占 1 座（机票按成人价减此折扣）；婴儿不占座、不占房，仍需护照。
  childSeatDiscountCnyPerPerson Int      @default(30)
  infantPriceCny                Int      @default(0)
  // 自备签证可减额（CNY）：套餐含签证费时，客人自备签证（不需要送签）则从套餐价减此额。
  // null = 跟随签证组件产品价（Visa.basePrice 合计；一处改价全站生效，2026-08-30 价格收敛拍板）；
  // 非 null = 套餐自有覆盖（含 0 = 显式不减，特价团用）。存量数据保持原显式值不迁移，行为不变。
  // 与 businessUpgradeCnyPerLeg 的「null = 跟随航班」同一套语义。
  selfVisaDeductCny             Int?
  // 机票航段数（来回 = 2，单程 = 1）— 升舱加价 = businessUpgradeCnyPerLeg × legs × businessCount
  legs                          Int      @default(2)
  // 运营封盘日（按出发日 D）：该日整套餐不可售，优先级高于库存判定。
  //   形如 [{date:"2026-02-15", reason:"春节封盘"}]；reason 可选。
  blackoutDates                 Json     @default("[]")
  // 该套餐前台默认出发日（YYYY-MM-DD）；null = 用全局默认。
  //   仅影响前台初始选中的出发日，不参与"可售判定"。
  defaultDepartDate             String?
  soldCount                     Int      @default(0) // 已售份数（展示用，seed 填充）
  isActive                      Boolean  @default(true)
  // 管理端可编辑的排序值：列表按 sortOrder 升序展示（数字小的排前面），null 排最后。
  // 运营用它把常用套餐置顶（如录单选套餐时）。
  sortOrder                     Int?
  // 结算价日历取价键（两者都空 = 该套餐不走日历，现状不变；都配了 = 纳入日历取价）：
  //   settlementTier   = 酒店档次（对齐 SettlementRate.tier）
  //   settlementNights = 住宿晚数（对齐 SettlementRate.nights）
  // 代理下该套餐单时，按去程出发日期 + 本组合查 SettlementRate 得到每人结算价（服务端权威定价）。
  settlementTier                SettlementTier?
  settlementNights              Int?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  hotelRoomType  HotelRoomType? @relation(fields: [hotelRoomTypeId], references: [id])
  outboundFlight Flight?        @relation("BundleOutboundFlight", fields: [outboundFlightId], references: [id], onDelete: SetNull)
  returnFlight   Flight?        @relation("BundleReturnFlight", fields: [returnFlightId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviews — 产品评价（前台展示 + 订单完成后客户提交）
// productId 是 polymorphic：按 productType 指向 Bundle/Hotel/Transfer/Visa.id，
// FLIGHT 评价用航线/航班号字符串做 productId（无强外键，故不建关系）。
// ─────────────────────────────────────────────────────────────────────────────
enum ProductReviewType {
  BUNDLE
  HOTEL
  TRANSFER
  VISA
  FLIGHT
}

model Review {
  id          String            @id @default(cuid())
  productType ProductReviewType
  productId   String
  rating      Int // 1-5
  title       String?
  body        String
  authorName  String // 已脱敏的展示名（"王**"）
  verified    Boolean           @default(false) // true = 来自真实订单
  tripType    String? // 家庭/情侣/朋友/商务
  reply       String? // 商家回复
  orderId     String? // 关联订单（订单后评价时填）
  createdAt   DateTime          @default(now())

  @@index([productType, productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  TICKETED
  COMPLETED
  PAYMENT_TIMEOUT
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
  CHANGE_REQUESTED
  CHANGED
  FAILED
}

// 订单级签证状态（录单时选择）：不需要 / 需要 / 电子签 / 已签证
//
// 本枚举只表达**签发方式层面的录单口径**，不表达入境次数：
// 入境次数（单次/多次）由签证产品的 Visa.entryType 决定，**不由本枚举表达**。
// （历史上 E_VISA 曾注为「电子签（三个月多次）」——那是某个具体签证产品的属性，
//  被误当成枚举语义后，代码据此把所有 E_VISA 单硬编码成「多次」，静默标错。）
enum VisaRequirement {
  NOT_NEEDED // 不需要
  NEEDED // 需要
  E_VISA // 电子签
  HAS_VISA // 已签证
}

enum OrderItemKind {
  FLIGHT
  HOTEL
  TRANSFER
  VISA
  BUNDLE
  INSURANCE
  FEE // airport construction / fuel surcharge
  DISCOUNT
  GUIDE // 导游服务费收入（财务细分）
  UPGRADE_CHANGE // 升舱 / 改期收入
  OVERSALE // 超售收入
}

enum InvoiceStatus {
  NONE // 不需要 / 未申请
  REQUESTED // 客户已要求开票
  ISSUED // 已开具
}

model Order {
  id                   String           @id @default(cuid())
  orderNumber          String           @unique // human-friendly, e.g., "FTM2026041400001"
  userId               String? // null for guest (no-login) checkout
  agentId              String? // non-null when placed by an agent
  sourceHoldOrderId    String? // 由占位单名单转正产生的来源单据
  // 游客下单（免登录）联系人 —— userId=null 时用于公开订单查询匹配 + 履约联系
  guestName            String?
  guestPhone           String?
  guestEmail           String?
  status               OrderStatus      @default(DRAFT)
  // 开票状态（旧的订单级单值，兼容保留）：REQUESTED 仍表示客户已要求开票；
  // 已被下面三个「按航段/系统」的布尔位取代作为主口径（票务岗六态）。
  invoiceStatus        InvoiceStatus    @default(NONE)
  // 六态开票（三个独立维度，不是一个枚举六值）—— 票务岗需按航段分别开票并导出：
  //   outboundInvoiced = 去程已开；returnInvoiced = 回程已开；systemInvoiced = 系统已开。
  // 去程/回程判定：订单 FLIGHT 行按班次 departureTime 升序，第 1 段=去程、第 2 段=回程
  //（单程只有去程；>2 段的罕见情形只认前两段）。存量 invoiceStatus=ISSUED 的单迁移回填三者=true。
  outboundInvoiced     Boolean          @default(false)
  returnInvoiced       Boolean          @default(false)
  systemInvoiced       Boolean          @default(false)
  // 「本单有回程航段」物化列 —— 与 determineFlightLegs 同口径（带班次的 FLIGHT 行按
  // departureTime 升序，存在第 2 段即 true）。Prisma where 表达不了「关联行 ≥ 2 条」，
  // 而「回程未开」筛选必须排掉单程单（单程单 returnInvoiced 恒为 false，天然误命中）。
  // 由 syncOrderHasReturnLeg 在所有增删 FLIGHT 行 / 改 flightScheduleId 的事务内同步维护。
  // 与软删无关：已删订单同样维护本列（列语义是结构，不是可见性）。
  hasReturnLeg         Boolean          @default(false)
  currency             String           @default("CNY")
  subtotal             Decimal          @db.Decimal(12, 2)
  taxesAndFees         Decimal          @default(0) @db.Decimal(12, 2)
  discountTotal        Decimal          @default(0) @db.Decimal(12, 2)
  total                Decimal          @db.Decimal(12, 2)
  paidAmount           Decimal          @default(0) @db.Decimal(12, 2)
  prepaymentOffset     Decimal          @default(0) @db.Decimal(12, 2)
  contactName          String
  contactPhone         String
  contactEmail         String?
  paymentExpiresAt     DateTime?
  idempotencyKey       String?          @unique
  notes                String? // 客户填写的特殊说明（兼容保留：老的自由文本备注框）
  internalNotes        String? // 运营/客服内部备忘（客户看不到）
  // 订单级签证状态（录单时选择）
  visaStatus           VisaRequirement?
  // 结构化备注四栏（取代「一个框 + 手工排序」的老做法）；与 notes 并存，互不影响
  noteHotel            String? // 酒店
  noteVisa             String? // 签证
  notePayment          String? // 付款
  noteSpecial          String? // 特殊
  // 防漏单：哪位运营接的单 + 接单时间
  claimedById          String?
  claimedAt            DateTime?
  // 套票拼房分配 — { roomGroups: [{ id, hotelName, roomType, passengerIds: [], notes }] }
  roomAssignment       Json?
  // 出纳：预期到账总额（CNY）+ 锁定标记。锁定后只 ADMIN 能改，避免运营随便改。
  expectedAmountCny    Decimal?         @db.Decimal(12, 2)
  expectedAmountLocked Boolean          @default(false)
  // 结算价锁定：核对完成后写保护，解锁后才允许通过改结算价端点修改。
  settlementLocked     Boolean          @default(false)
  settlementLockedAt   DateTime?
  settlementLockedBy   String? // userId
  // 收款复核锁：财务/出纳对账复核无误后锁定本单收款，锁定后禁止人工录新收款
  // （人工确认 / 批量确认）；解锁后才可再录。网关到账 / 对账认款（真钱已到）不受此锁影响。
  paymentsLocked       Boolean          @default(false)
  paymentsLockedAt     DateTime?
  paymentsLockedBy     String? // userId
  // 售后费用（改期费 / 换人费等）：累计客户应补付的金额（CNY，整数）。
  // 应付 = total + adjustmentCny；尾款 = total + adjustmentCny − paidAmount。
  // 不改 total/subtotal（机票基础价不重算），只在结清口径上叠加。
  adjustmentCny        Int              @default(0)
  // 售后费用流水（审计）：[{ type, label, amountCny, at, by }]
  // type ∈ RESCHEDULE_FEE | SWAP_FEE | ...；by = 操作人 userId（无则 null）
  adjustments          Json             @default("[]")
  // 软删除：非空 = 已删。删除 = 从所有列表/导出/统计里消失，但整行数据保留可追溯。
  // 仅内部员工（ADMIN/STAFF）可删，且只允许删「已释放座位」的订单（守卫见 orders.service.softDeleteOrder），
  // 删除本身绝不触碰库存/座位账（不偷偷释放）。查询口径统一挂 deletedAt: null 排除。
  deletedAt            DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user              User?                 @relation("OrderUser", fields: [userId], references: [id])
  agent             Agent?                @relation(fields: [agentId], references: [id])
  sourceHoldOrder   HoldOrder?            @relation("HoldSourceOrders", fields: [sourceHoldOrderId], references: [id], onDelete: SetNull)
  claimedBy         User?                 @relation("OrderClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  items             OrderItem[]
  costItems         OrderCostItem[]
  passengers        Passenger[]
  payments          Payment[]
  refunds           Refund[]
  statusEvents      OrderStatusEvent[]
  commissionRecords CommissionRecord[]
  notifications     NotificationLog[]
  reminders         OperationalReminder[]
  holdConversions   HoldConversionRecord[]
  splitsOut         OrderSplitRecord[]     @relation("SplitSource")
  splitsIn          OrderSplitRecord[]     @relation("SplitTarget")

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([sourceHoldOrderId])
  @@index([status])
  @@index([createdAt])
  @@index([claimedById])
  @@index([deletedAt])
}

model OrderItem {
  id               String        @id @default(cuid())
  orderId          String
  kind             OrderItemKind
  description      String
  // 录单时自定义的产品名称快照（仅后台展示用）：NULL = 未自定义，前端按既有逻辑自动拼装。
  // 与 description 分离——description 会被换酒店/补房差等流程自动重写，此字段一经写入不再变动。
  quantity         Int           @default(1)
  unitPrice        Decimal       @db.Decimal(10, 2)
  amount           Decimal       @db.Decimal(12, 2)
  // 成本快照（CNY/件）— 下单时锁定的真实采购成本；NULL = 老数据，未回填
  unitCostCny      Decimal?      @db.Decimal(10, 2)
  // 总成本（CNY）= unitCostCny × quantity；NULL = 老数据
  totalCostCny     Decimal?      @db.Decimal(12, 2)
  // Optional links — exactly one set depending on kind.
  flightScheduleId String?
  flightCabin      CabinClass?
  hotelRoomTypeId  String?
  // 星级随机池占用行（3=三星随机、4=四星随机）：kind=HOTEL 且 hotelRoomTypeId 为空且本列非空 =
  // 客人买的是「N 星随机」，还没落到具体酒店，占的是星级随机池的库存（见 HotelBlockPeriod 注释）。
  // 房控把这单落到具体酒店时（换酒店流程）改写 hotelRoomTypeId 并清空本列，占用随之从池转到该酒店。
  // 入住区间/间数沿用 hotelCheckIn/hotelCheckOut/roomsBilled，与具体酒店行完全同构。
  randomStarTier   Int?
  hotelCheckIn     DateTime?     @db.Date
  hotelCheckOut    DateTime?     @db.Date
  transferId       String?
  visaId           String?
  // 签证预计出行日期（可空）：纯签证单的业务日期锚点。
  // 签证业务本身没有航班行、也没有酒店入住日，但办签一定有个「打算什么时候走」——录单时填这个
  // 日期，订单「出发日」派生就有了第三级回退（最早航班 → 最早酒店入住 → 本列），按出发日期
  // 区间导出不再把纯签证单静默漏掉。可空：老数据、以及行程尚未定的单继续留空。
  visaIntendedDate DateTime?     @db.Date
  bundleId         String?
  // 按乘客调价（0722 公测反馈）：非空 = 本调整行只作用于该乘客的应收份额（金额明细逐人可解释）；
  // NULL = 整单调价（现行为不变）。仅对 metadata.priceAdjustment 行有意义；其它商品行一律 NULL。
  // onDelete: SetNull —— 乘客被清除时不丢金额（差额仍留在 total），只失去归属，绝不静默改动订单总额。
  passengerId      String?
  metadata         Json?
  // 计费/占房间数（允许 0.5，用于拼房：7 人 3.5 间、1 人占半间）。
  // NULL = 老数据/未显式分房 → 房控按容量算法或 metadata.roomsNeeded 回落。
  roomsBilled      Decimal?      @db.Decimal(4, 1)
  // 幂等键（仅补房差等事后追加 FEE 行用）：同 key 重试只入账一次，防双击/网络重发叠加多条 FEE。
  idempotencyKey   String?       @unique
  createdAt        DateTime      @default(now())

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  flightSchedule   FlightSchedule?   @relation(fields: [flightScheduleId], references: [id])
  hotelRoomType    HotelRoomType?    @relation(fields: [hotelRoomTypeId], references: [id])
  transfer         Transfer?         @relation(fields: [transferId], references: [id])
  visa             Visa?             @relation(fields: [visaId], references: [id])
  bundle           Bundle?           @relation(fields: [bundleId], references: [id])
  passenger        Passenger?        @relation(fields: [passengerId], references: [id], onDelete: SetNull)
  fulfillmentTasks FulfillmentTask[]

  @@index([orderId])
  @@index([passengerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 订单杂项成本 — 财务录入的订单级成本明细（财务细分：导游/赠送/手续费/操作费/其他）
// 跟 OrderItem 区分：OrderItem 是面向客户的商品行；OrderCostItem 是后台财务的成本明细
// 一张订单可有 N 条（一类可多条）
// ─────────────────────────────────────────────────────────────────────────────
enum OrderCostCategory {
  GUIDE_SERVICE // 导游服务费
  COMP_GIFT // 赠送费用
  HANDLING_FEE // 手续费
  OPERATION_FEE // 操作费（订单录入/服务人员费，每单固定）
  OTHER // 其他
}

model OrderCostItem {
  id        String            @id @default(cuid())
  orderId   String
  category  OrderCostCategory
  amountCny Decimal           @db.Decimal(12, 2)
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, category])
}

// ─────────────────────────────────────────────────────────────────────────────
// Fulfillment Tasks — 出票 / 酒店确认 / 签证进度 / 司机调度
// ─────────────────────────────────────────────────────────────────────────────
enum FulfillmentType {
  FLIGHT_TICKETING // 出票（PNR + e-ticket number）
  HOTEL_BOOKING // 酒店预订（confirmation number）
  VISA_APPLICATION // 签证申请（application number + progress）
  TRANSFER_DISPATCH // 接送调度（driver + vehicle）
  BUNDLE_COMPOSITE // 套餐：需拆解为多个子任务
}

enum FulfillmentStatus {
  PENDING
  IN_PROGRESS
  CONFIRMED
  CANCELLED
  FAILED
}

model FulfillmentTask {
  id             String            @id @default(cuid())
  orderItemId    String
  type           FulfillmentType
  status         FulfillmentStatus @default(PENDING)
  // 多态 data：FLIGHT → {pnr, eTicketNumber}
  //            HOTEL  → {confirmationNumber}
  //            VISA   → {applicationNumber, progress}
  //            TRANSFER → {driverName, vehicleNumber}
  data           Json?
  notes          String?
  attempts       Int               @default(0)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  failureReason  String?
  assigneeUserId String? // 谁负责这条任务

  // ── 签证实际成本（仅 VISA_APPLICATION 任务用；人均口径）──
  // 签证公司按航班开美金账单，团价/加急价按单不同，产品主数据 Visa.costPriceCny 表达不了。
  // CNY 为入账权威：填了 USD+汇率则自动折算 CNY 存底，也允许直接填 CNY。三者皆空 = 回退产品主数据成本。
  visaUnitCostUsd Decimal? @db.Decimal(10, 2) // 人均成本（美金），签证公司账单币种
  visaFxRate      Decimal? @db.Decimal(12, 6) // 折算汇率（USD→CNY）
  visaUnitCostCny Decimal? @db.Decimal(10, 2) // 人均成本（人民币，入账权威）
  // 本次实际送签的签证公司（财务对账用）。产品主数据 Visa.supplier 只是产品默认供应商，
  // 同一产品不同批次可能换公司，故按任务记录；空 = 未填（此前只能塞在备注文本里）。
  visaSupplier    String?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([status])
  @@index([type, status])
}

model Passenger {
  id             String        @id @default(cuid())
  orderId        String
  fullName       String
  // 航司 PNR 标准字段：姓 / 名 拆开（fullName 仍保留兼容）
  lastName       String?
  firstName      String?
  title          String? // MR / MRS / MS / MSTR / MISS
  gender         Gender?
  documentType   DocumentType
  documentNumber String
  // 建单时必填（见 orders.schemas passengerInputSchema）；可空仅服务「换人清除」——
  // 换人后未提供新生日时置 null，避免残留前一位出行人的生日。
  dateOfBirth    DateTime?
  placeOfBirth   String?
  nationality    String
  passengerType  PassengerType @default(ADULT)

  // ── 护照扩展（出票 + 签证用）──
  chineseName          String? // 中文姓名（OCR 识别或手工填写）
  passportIssueDate    DateTime? @db.Date // 护照签发日期
  passportIssueCountry String? // 颁发国 ISO-2，如 CHN
  passportIssuePlace   String? // 护照签发地点（城市/机关文本，OCR 识别或手填，选填）
  passportExpiry       DateTime? @db.Date

  // ── 签证（已签发的，给出票/接送参考）──
  visaNumber               String?
  visaType                 String? // E-visa / Sticker / Approval letter
  visaIssueDate            DateTime? @db.Date
  // 签证生效日（线下确认模版的"生效时间"，可与出签日不同）
  visaEffectiveDate        DateTime? @db.Date
  visaExpiry               DateTime? @db.Date
  visaPlaceOfIssue         String?
  visaCountryOfApplication String?

  // ── 地址（航司提交格式需要）──
  addressType    String? // BUSINESS / RESIDENTIAL
  addressDetails String? // 详细地址
  addressCity    String?
  addressState   String?
  addressCountry String? // ISO-2
  addressZip     String?

  mealPreference      String?
  needsWheelchair     Boolean @default(false)
  needsInfantBassinet Boolean @default(false)
  // 拼房用 — 客人偏好：SINGLE/DOUBLE/TWIN/SHARE_OK
  bedPref             String?

  // ── 套餐乘客级选项（购物车模式：同一订单每人各选自己的住宿方式 + 签证；价差全部系统算）──
  //   visaExempt = 客人自备签证（无需送签）：签证台按此过滤掉该乘客，套餐价按人扣减 selfVisaDeductCny。
  //   singleRoom = 单住（不拼房，按人收单房差）；默认 false = 拼房。
  // 均 @default(false) → 旧数据/旧客户端天然回落「随套餐办签 + 拼房」，与扩展前定价完全一致。
  visaExempt       Boolean @default(false)
  singleRoom       Boolean @default(false)
  // 按人送签进度（部分送签用）——非自备签乘客各自记录；签证台按人标记，
  // 任务级 FulfillmentStatus 由本字段派生（全部到某档任务才算该档，部分时取最早档）。
  // @default(PENDING) → 旧数据/旧客户端天然回落「待处理」，与扩展前口径一致。
  visaSubmissionStatus VisaSubmissionStatus @default(PENDING)
  // 护照照片（OCR 上传或人工补传）
  passportPhotoUrl String?

  pnr           String? // booked PNR from airline
  eticketNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // 按乘客调价行（0722）：本乘客名下的价格调整 OrderItem（SetNull——清人不丢金额，只失归属）。
  adjustmentItems OrderItem[]

  @@index([orderId])
}

model OrderStatusEvent {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?
  reason      String?
  metadata    Json?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([orderId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentMethod {
  WECHAT_PAY
  ALIPAY
  BANK_CARD
  AGENT_PREPAYMENT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  transactionId  String?       @unique // gateway transaction id
  idempotencyKey String?       @unique // 人工确认收款幂等键：同 key 重试只入账一次
  gatewayPayload Json?
  // 人工确认收款上传的截图（data URL；线下收款凭证）
  proofUrl       String?
  paidAt         DateTime?
  // 财务核实（到账双状态）：人工录入的到账只是「业务已收」，财务对过银行/收单流水后落 verifiedAt
  // 才算「已核实」。认款/网关回调等财务侧入口在创建时即核实；存量数据迁移时一次性视同已核实。
  verifiedAt     DateTime?
  verifiedById   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([status, verifiedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// 统一收款 + 收款对账台 + 挂账池（Receipts / Reconciliation / Suspense pool）
//
// 公司用统一收款码收钱（微信/支付宝/银行），客服/财务在后台手动对账：
//   - 客户下单后看到统一收款码 + 应付金额，可上传付款凭证（仅"声明"，不直接入账）
//   - 财务在后台登记进账（Receipt），再手动认领（allocate）到订单或退款
//   - 暂时认不出是哪单的钱，先进"挂账池"（status=OPEN 的 Receipt），财务再处理
//   - 订单超额的钱也可放挂账池（source=ORDER_OVERPAY）
//
// 一笔 Receipt 可被拆成多笔 ReceiptAllocation 认领到不同订单；
// 每次认领复用人工确认收款的入账内核（PaymentsService 内 within-tx 变体），
// 因此认领 = 给订单累加 paidAmount + 全额自动翻 PAID + 审计，和直接确认收款口径完全一致。
// ─────────────────────────────────────────────────────────────────────────────

// 统一收款渠道（收款码 / 收款账户），供客户付款页展示。
model PaymentChannel {
  id          String   @id @default(cuid())
  kind        String // WECHAT | ALIPAY | BANK
  label       String // 展示名，如「微信收款码」「公司对公账户」
  qrImageUrl  String?  @db.Text // 收款码图片（data URL，≤6MB）
  accountText String?  @db.Text // 账户信息文本（开户行/账号/户名等）
  note        String?  @db.Text // 备注（如「请备注订单号」）
  // 专属代理（部分代理有专用收款二维码；NULL = 公司统一码，对所有人展示）
  agentId     String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@index([agentId])
}

// 进账（挂账池）状态。
enum ReceiptStatus {
  OPEN // 未认领（在挂账池里）
  PARTIALLY_ALLOCATED // 部分已认领
  ALLOCATED // 已全部认领
  REFUNDED // 剩余未认领部分已退款
}

// 进账来源。
enum ReceiptSource {
  CUSTOMER_UPLOAD // 客户上传付款凭证（仅声明）
  STAFF_ENTRY // 财务/客服后台登记
  ORDER_OVERPAY // 订单超额转入挂账池
  STATEMENT_IMPORT // 收单平台二维码流水导入（按交易流水号去重）
  OPS_CLAIM // 运营凭客户水单手工登记（占位单手工到账；财务对流水后核实）
}

// 一笔到账（统一收款码收到的钱）。
model Receipt {
  id           String        @id @default(cuid())
  receiptNo    String        @unique // 人类可读，如「RCP2026061800001」
  amountCny    Decimal       @db.Decimal(14, 2) // 到账总额
  allocatedCny Decimal       @default(0) @db.Decimal(14, 2) // 已认领额（remaining = amount − allocated）
  method       PaymentMethod
  proofUrl     String?       @db.Text // 付款凭证截图（data URL，≤6MB）
  payerNote    String? // 付款人备注（客户填的订单号/留言）
  // 收单平台交易流水号（流水导入专用；唯一 → 同一笔流水绝不重复入池）
  externalTxnId String? @unique
  orderHintId  String? // 疑似归属订单（客户上传时带的；仅提示，不等于已认领）
  receivedAt   DateTime // 到账时间（财务可手填）
  source       ReceiptSource
  status       ReceiptStatus @default(OPEN)
  refundNote   String? // 退款备注（仅 REFUNDED 时）
  // 财务核实（仅 source=OPS_CLAIM 有意义）：运营凭水单登记的到账，财务对过流水后落 verifiedAt。
  verifiedAt   DateTime?
  verifiedById String?
  createdById  String? // 登记人 userId（系统/客户上传时为 null）
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  allocations     ReceiptAllocation[]
  holdAllocations HoldReceiptAllocation[]

  @@index([status])
  @@index([receivedAt])
  @@index([orderHintId])
}

// 一笔进账认领到某订单的记录（一笔进账可拆多条认领到不同订单）。
model ReceiptAllocation {
  id          String   @id @default(cuid())
  receiptId   String
  orderId     String
  amountCny   Decimal  @db.Decimal(14, 2)
  createdById String?
  createdAt   DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([orderId])
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

model Refund {
  id             String       @id @default(cuid())
  orderId        String
  amount         Decimal      @db.Decimal(12, 2)
  reason         String?
  status         RefundStatus @default(REQUESTED)
  processedAt    DateTime?
  gatewayPayload Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Pricing
// ─────────────────────────────────────────────────────────────────────────────

model PricingConfig {
  id                 String   @id @default(cuid())
  flightScheduleId   String   @unique
  // JSON: [{tier: "A", minDaysOut: 30, minLoadFactor: 0, multiplier: 1.0}, ...]
  tiers              Json
  // optional ML-derived demand multiplier, refreshed weekly
  mlDemandMultiplier Decimal? @db.Decimal(6, 4)
  updatedAt          DateTime @updatedAt

  flightSchedule FlightSchedule @relation(fields: [flightScheduleId], references: [id], onDelete: Cascade)
  overrides      TierOverride[]
  priceHistory   PriceHistory[]
}

model TierOverride {
  id              String    @id @default(cuid())
  pricingConfigId String
  tier            String // "A" | "B" | "C" | "D"
  multiplier      Decimal   @db.Decimal(6, 4)
  reason          String?
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdById     String
  createdAt       DateTime  @default(now())

  pricingConfig PricingConfig @relation(fields: [pricingConfigId], references: [id], onDelete: Cascade)

  @@index([pricingConfigId, effectiveFrom])
}

model PriceHistory {
  id              String     @id @default(cuid())
  pricingConfigId String
  cabin           CabinClass
  price           Decimal    @db.Decimal(10, 2)
  tier            String
  observedAt      DateTime   @default(now())

  pricingConfig PricingConfig @relation(fields: [pricingConfigId], references: [id], onDelete: Cascade)

  @@index([pricingConfigId, observedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cancellation policies — 取消订单的退款手续费阶梯
// ─────────────────────────────────────────────────────────────────────────────
//
// tiers JSON 形如：
//   [
//     { "hoursBeforeDeparture": 168, "feePercent": 0   },  // 7+ 天，免费
//     { "hoursBeforeDeparture": 72,  "feePercent": 20  },  // 3-7 天，20% 手续费
//     { "hoursBeforeDeparture": 24,  "feePercent": 50  },  // 1-3 天，50%
//     { "hoursBeforeDeparture": 0,   "feePercent": 80  },  // <1 天，80%
//     { "hoursBeforeDeparture": -1,  "feePercent": 100 }   // 已起飞 / 已入住，100%
//   ]
//
// 找匹配 tier 算法：取 hoursLeft >= tier.hoursBeforeDeparture 中 hoursBeforeDeparture 最大的一档；
// 都不满足（i.e. 已过 0 小时）→ 取 hoursBeforeDeparture = -1 那条（"已履约"档）。
//
// 优先级：scope 精确匹配 > 同 productKind 的 isDefault=true。
//
model CancellationPolicy {
  id          String        @id @default(cuid())
  productKind OrderItemKind
  // 可选范围限定（null = 该 kind 的通用策略；非 null = 针对特定班次/酒店房型/套餐）
  // scope 是 polymorphic，按 productKind 解释：FLIGHT→FlightSchedule.id, HOTEL→HotelRoomType.id, BUNDLE→Bundle.id ...
  scope       String?
  name        String // 人类可读，例 "默认机票退订" / "国庆班次特殊政策"
  tiers       Json // 见上方注释；运行时校验 hoursBeforeDeparture 单调递减、feePercent 0-100
  isDefault   Boolean       @default(false) // true = 该 kind 的兜底；同 kind 只允许一条 isDefault
  isActive    Boolean       @default(true)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([productKind, scope]) // 同 kind+scope 唯一
  @@index([productKind, isDefault])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  SMS
  EMAIL
  WECHAT
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  RETRYING
}

model NotificationLog {
  id           String              @id @default(cuid())
  orderId      String?
  userId       String?
  channel      NotificationChannel
  recipient    String // phone, email, or openid
  template     String // template key
  payload      Json
  status       NotificationStatus  @default(QUEUED)
  attemptCount Int                 @default(0)
  lastError    String?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  order Order? @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Dynamic Pricing — Date Ranking
// ─────────────────────────────────────────────────────────────────────────────

/// 日期等级表 — 每天一行 (A/B/C/D)。Seed 自动按 DOW 填充，admin 可手动 override。
model DateRanking {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date // 出发本地日期（UTC midnight 存）
  rank      String // "A" | "B" | "C" | "D"
  reason    String? // "春节" | "default:Friday" | "manual override"
  isManual  Boolean  @default(false) // true = admin 手动覆盖
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Operational Reminders（操作部待办/特殊提醒）
// 用户场景：签证截止前要送批文；出票前要拿酒店单过海关；客人特殊改期
// ─────────────────────────────────────────────────────────────────────────────
model OperationalReminder {
  id            String           @id @default(cuid())
  orderId       String? // 可选关联订单（独立待办则为 null）
  createdById   String // 提单人
  claimedById   String? // 认领人（null = 未认领）
  title         String // 一句话标题
  body          String? // 详细说明
  dueAt         DateTime?        @db.Date
  priority      ReminderPriority @default(NORMAL)
  status        ReminderStatus   @default(OPEN)
  attachmentUrl String? // 截图 / 文件链接（小程序/客人发来的）
  // 规则化自动生成的幂等键（如 BALANCE:{orderId}:{出发日}）；手工创建的为 null。
  // 同一 ruleKey 只生成一次，重复跑生成任务不刷屏。
  ruleKey       String?          @unique
  resolvedAt    DateTime?
  resolvedNote  String? // 完成或跳过的说明
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  order     Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User   @relation("ReminderCreator", fields: [createdById], references: [id])
  claimedBy User?  @relation("ReminderClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status, priority, dueAt])
  @@index([claimedById, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI OCR 配置 — 单例表（最多一行），存后台粘贴的 Qwen-VL API Key
// 读取优先级：DB > env（DASHSCOPE_API_KEY / QWEN_BASE_URL / QWEN_VL_MODEL）
// ─────────────────────────────────────────────────────────────────────────────
model AiOcrConfig {
  id          String   @id @default(cuid())
  provider    String   @default("QWEN")
  apiKey      String? // 明文存库；序列化给前端时打码（不返回原文）
  baseUrl     String?
  model       String?
  enabled     Boolean  @default(true)
  updatedById String? // 最后修改人 userId
  updatedAt   DateTime @updatedAt
}

// 运营可自调的系统开关（通用键值）。首个键 = 酒店超售容忍上限（房控页可改，
// 无记录回落 env.HOTEL_MAX_OVERSELL_ROOMS 缺省）；后续同类小开关复用此表，别再开专表。
model SystemSetting {
  key         String   @id
  value       String
  updatedById String? // 最后修改人 userId
  updatedAt   DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// 营销中心 · 海报 —— AI 生成的航线宣传图 + 配套文案
//
// 核心约束：**海报上的硬数据一律来自事实快照，不让模型绘制**。
// 生图模型只生成无字背景；航班号、时刻、航线、生效日期和行李额由服务端代码叠字，
// 文案模板中的硬数据也由服务端替换。verifyReport 虽沿用历史字段名，但不再存视觉回读结果。
// ─────────────────────────────────────────────────────────────────────────────
enum MarketingPosterKind {
  FLIGHT_ROUTE // 航线海报：航班号 + 起降时刻 + 行李额
  CUSTOM // 自由主题（只有文案，无强校验事实）
}

enum MarketingPosterStatus {
  GENERATING // 兼容历史默认值；新流程生成期间不落库
  READY // 背景生成并完成服务端叠字
  NEEDS_REVIEW // 历史状态，方案 B 不再因校验新写入
  FAILED // 出图或服务端合成失败
}

model MarketingPoster {
  id     String                @id @default(cuid())
  kind   MarketingPosterKind
  status MarketingPosterStatus @default(GENERATING)
  title  String // 运营给的名字，列表里用来认

  // 数据锚点：航线海报关联的航班（删航班不删海报，留档）
  flightId String?

  // 生成参数（便于「按同样的设定再来一张」）
  templateKey String // 版式 key，见 marketing.templates
  size        String @default("1080*1440")
  imageModel  String
  prompt      String @db.Text

  // 事实快照 —— 生成当时从库里取的真值，也是服务端叠字与事后追溯依据
  facts Json

  // 成图。DashScope 返回的 OSS URL 24 小时过期，必须落库转存，不能存外链。
  imageDataUrl String? @db.Text

  // 生成尝试次数与渲染元信息
  attempts     Int   @default(0) // 已尝试出图次数（含重试）
  // 历史字段名为 verifyReport；兼容保留，现存版式、字体、绘制字段、截断及文案丢弃原因
  verifyReport Json? // 新语义：渲染与文案核验元信息，不再存视觉模型回读结果

  // 配套文案（同一次生成产出，运营直接复制）
  copyMoments String? @db.Text // 朋友圈
  copyAgent   String? @db.Text // 发代理群
  copyXhs     String? @db.Text // 小红书笔记

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flight    Flight? @relation(fields: [flightId], references: [id], onDelete: SetNull)
  createdBy User    @relation("MarketingPosterCreator", fields: [createdById], references: [id])

  @@index([status, createdAt])
  @@index([flightId])
}

