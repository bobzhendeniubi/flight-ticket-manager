// Flight Ticket Manager — Prisma schema
// Covers M1 issue #1: PostgreSQL multi-schema design (Redis/OpenSearch handled at app layer).
// All ids are cuid() strings; timestamps are UTC; monetary amounts are Decimal(12, 2) CNY.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  AGENT
  STAFF
  ADMIN
}

enum DocumentType {
  ID_CARD // 居民身份证
  PASSPORT
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

// 航司提交格式需要：M/F；X 留给非常规护照
enum Gender {
  M
  F
  X
}

// 操作部待办状态机
enum ReminderStatus {
  OPEN // 新建待处理
  IN_PROGRESS // 已认领处理中
  DONE // 完成
  SKIPPED // 不处理（含原因）
}

enum ReminderPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL // 签证截止/航班延误等
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  phone         String?   @unique
  passwordHash  String? // null for WeChat-only users
  role          UserRole  @default(CUSTOMER)
  displayName   String?
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  wechatOpenId  String?   @unique
  wechatUnionId String?   @unique
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens    RefreshToken[]
  savedPassengers  SavedPassenger[]
  orders           Order[]               @relation("OrderUser")
  claimedOrders    Order[]               @relation("OrderClaimedBy")
  agentProfile     Agent?
  orderEvents      OrderStatusEvent[]
  customerProfile  CustomerProfile?
  auditLogs        AuditLog[]
  remindersCreated OperationalReminder[] @relation("ReminderCreator")
  remindersClaimed OperationalReminder[] @relation("ReminderClaimedBy")
  seatLocks        SeatLock[]
  seatWaitlists    SeatWaitlist[]

  @@index([role])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256 of the refresh token
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SavedPassenger {
  id             String        @id @default(cuid())
  userId         String
  fullName       String
  documentType   DocumentType
  documentNumber String
  dateOfBirth    DateTime
  nationality    String // ISO 3166-1 alpha-2 (e.g., CN, US)
  passengerType  PassengerType @default(ADULT)
  phone          String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, documentNumber])
  @@index([userId])
  @@index([fullName])
  @@index([dateOfBirth])
}

// ─────────────────────────────────────────────────────────────────────────────
// Customer Profile — 客户画像（User.role=CUSTOMER 的扩展信息）
// ─────────────────────────────────────────────────────────────────────────────
model CustomerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  idNumber       String? // 身份证/护照号
  primaryAgentId String? // 归属代理（null = 直销散客）
  tags           String[] // ["VIP", "回头客", "蜜月"]
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryAgent Agent? @relation(fields: [primaryAgentId], references: [id])

  @@index([primaryAgentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit Log — 全站敏感操作留痕
// ─────────────────────────────────────────────────────────────────────────────
enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AuditTargetType {
  AGENT
  ORDER
  FLIGHT
  CUSTOMER
  TRAVELER
  PRICING
  COMMISSION
  SETTLEMENT
  PRODUCT
  AUTH
  SYSTEM
}

model AuditLog {
  id          String          @id @default(cuid())
  actorUserId String? // null = 系统操作（定时任务等）
  actorLabel  String? // 缓存的 email/displayName（防用户删除后丢信息）
  actorRole   String?
  action      String // CREATE_AGENT / UPDATE_PRICING / ADVANCE_ORDER_STATUS ...
  targetType  AuditTargetType
  targetId    String?
  targetLabel String? // 人类可读的对象名称
  before      Json?
  after       Json?
  severity    AuditSeverity   @default(INFO)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime        @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([severity])
}

// ─────────────────────────────────────────────────────────────────────────────
// Agents
// ─────────────────────────────────────────────────────────────────────────────

// 代理结算模式：逐单到账（每张订单都要见到钱才算清）/ 月结挂账（月底统一对账，单张订单不催款）
enum SettlementMode {
  PER_ORDER // 逐单到账
  MONTHLY // 月结挂账
}

model Agent {
  id                String         @id @default(cuid())
  userId            String         @unique
  companyName       String?
  contactName       String
  contactPhone      String
  prepaymentBalance Decimal        @default(0) @db.Decimal(14, 2) // CNY, can be negative only by admin override
  // 结算模式：PER_ORDER（默认，逐单见钱）/ MONTHLY（月结代理，单张订单挂账不催款，月底统一对账）
  settlementMode    SettlementMode @default(PER_ORDER)
  isActive          Boolean        @default(true)
  notes             String?
  // 代理层级 — 1 级代理 parentAgentId = null；上级创建下级时 tier = parent.tier + 1
  parentAgentId     String?
  tier              Int            @default(1)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentAgent            Agent?                  @relation("AgentHierarchy", fields: [parentAgentId], references: [id])
  childAgents            Agent[]                 @relation("AgentHierarchy")
  prepaymentTransactions PrepaymentTransaction[]
  commissionRules        CommissionRule[]
  commissionRecords      CommissionRecord[]
  settlements            Settlement[]
  orders                 Order[]
  customers              CustomerProfile[]

  @@index([isActive])
  @@index([parentAgentId])
  @@index([tier])
}

enum PrepaymentTxType {
  TOP_UP
  OFFSET // used on an order
  ADJUSTMENT // admin manual adjustment
  REFUND // returned from a cancelled order
}

model PrepaymentTransaction {
  id           String           @id @default(cuid())
  agentId      String
  amount       Decimal          @db.Decimal(14, 2) // positive = credit, negative = debit
  balanceAfter Decimal          @db.Decimal(14, 2)
  type         PrepaymentTxType
  orderId      String? // set when tied to an order
  description  String?
  createdById  String // user id of the admin/agent/system actor
  createdAt    DateTime         @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([orderId])
}

enum ProductKind {
  FLIGHT
  HOTEL
  TRANSFER
  VISA
}

model CommissionRule {
  id            String      @id @default(cuid())
  agentId       String
  productKind   ProductKind
  // commission rate as a decimal fraction, e.g. 0.0500 = 5.00%
  rate          Decimal     @db.Decimal(6, 4)
  effectiveFrom DateTime    @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, productKind, effectiveFrom])
  @@index([agentId])
}

enum CommissionStatus {
  ACCRUED
  SETTLEMENT_REQUESTED
  SETTLED
  REVERSED
}

model CommissionRecord {
  id           String           @id @default(cuid())
  agentId      String
  orderId      String
  productKind  ProductKind
  baseAmount   Decimal          @db.Decimal(12, 2) // the order item amount commission is computed on
  rate         Decimal          @db.Decimal(6, 4) // net rate (this_agent.rate - child.rate if in chain)
  amount       Decimal          @db.Decimal(12, 2) // baseAmount * rate
  status       CommissionStatus @default(ACCRUED)
  // 0=seller, 1=seller's parent, 2=grandparent ... 用于结算时计算 "commissionPaidToChildren"
  chainDepth   Int              @default(0)
  settlementId String? // nullable until included in a settlement
  settledAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  agent      Agent       @relation(fields: [agentId], references: [id])
  order      Order       @relation(fields: [orderId], references: [id])
  settlement Settlement? @relation(fields: [settlementId], references: [id])

  @@index([agentId, status])
  @@index([orderId])
  @@index([settlementId])
  // 结算热路径：按 (agentId, status, createdAt) 查本期 ACCRUED
  @@index([agentId, status, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Settlement — 月度结算单，每个代理每月 1 张
// ─────────────────────────────────────────────────────────────────────────────
enum SettlementStatus {
  DRAFT // 生成后的初始状态
  PENDING_APPROVAL // 提交审核
  APPROVED // 管理员核准，待支付
  PAID // 已支付给代理（CommissionRecord → SETTLED，prepaymentOffset 已扣）
  VOIDED // 作废（比如重算）
}

model Settlement {
  id                       String           @id @default(cuid())
  period                   String // YYYY-MM
  agentId                  String
  orderCount               Int              @default(0)
  grossRevenue             Decimal          @default(0) @db.Decimal(14, 2)
  commissionEarned         Decimal          @default(0) @db.Decimal(14, 2)
  commissionPaidToChildren Decimal          @default(0) @db.Decimal(14, 2)
  netCommission            Decimal          @default(0) @db.Decimal(14, 2)
  prepaymentOffset         Decimal          @default(0) @db.Decimal(14, 2)
  payableToAgent           Decimal          @default(0) @db.Decimal(14, 2)
  status                   SettlementStatus @default(DRAFT)
  generatedAt              DateTime         @default(now())
  approvedAt               DateTime?
  paidAt                   DateTime?
  notes                    String?
  updatedAt                DateTime         @updatedAt

  agent       Agent              @relation(fields: [agentId], references: [id])
  commissions CommissionRecord[]

  @@unique([period, agentId])
  @@index([period])
  @@index([status])
  @@index([agentId, period])
}

// ─────────────────────────────────────────────────────────────────────────────
// Products — Flights
// ─────────────────────────────────────────────────────────────────────────────

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

model Flight {
  id              String   @id @default(cuid())
  flightNumber    String // e.g., "CA1234"
  originCode      String // IATA code, e.g., "PEK"
  destinationCode String // IATA code
  originTerminal  String?
  destTerminal    String?
  aircraftType    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schedules       FlightSchedule[]
  costPeriods     FlightCostPeriod[]
  baggagePolicies FlightBaggagePolicy[]

  @@unique([flightNumber])
  @@index([originCode, destinationCode])
}

// 行李规则 — 按 航班 × 舱等 配置（公斤 / 件数都可单独留空）
model FlightBaggagePolicy {
  id            String     @id @default(cuid())
  flightId      String
  cabin         CabinClass
  checkedKg     Int? // 托运额度（kg/人）
  checkedPieces Int? // 托运件数（件/人）
  carryOnKg     Int? // 手提额度（kg/人）
  note          String? // 补充说明（如"超件 ¥xx/件"）
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, cabin])
}

model FlightSchedule {
  id               String   @id @default(cuid())
  flightId         String
  departureTime    DateTime // UTC
  arrivalTime      DateTime // UTC
  departureTz      String // IANA tz, e.g., "Asia/Shanghai"
  arrivalTz        String
  // 包机总成本（CNY）— 整班次付给航司的包机价；按"卖出座位 / 总成本"算单座分摊
  charterCostCny   Decimal? @db.Decimal(12, 2)
  // 机场税（CNY/人）— 出发地 / 目的地分开（岘港、澳门税率不同）
  airportTaxDepCny Decimal? @db.Decimal(10, 2)
  airportTaxArrCny Decimal? @db.Decimal(10, 2)
  // 财务追加成本（CNY/人；起降折扣可填负数代表减项）—— 都是 per-passenger
  fuelCostCny        Decimal? @db.Decimal(10, 2)
  peakSurchargeCny   Decimal? @db.Decimal(10, 2)
  aircraftAdjustCny  Decimal? @db.Decimal(10, 2)
  takeoffDiscountCny Decimal? @db.Decimal(10, 2)
  // 航司开票上限（张/班次）— 同一班次 invoiceStatus=ISSUED 的乘客数不得超过此值
  ticketingCap     Int      @default(191)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  flight        Flight            @relation(fields: [flightId], references: [id], onDelete: Cascade)
  seatClasses   FlightSeatClass[]
  orderItems    OrderItem[]
  pricingConfig PricingConfig?
  seatLocks     SeatLock[]
  seatWaitlists SeatWaitlist[]

  @@index([flightId, departureTime])
  @@index([departureTime])
}

model FlightSeatClass {
  id         String     @id @default(cuid())
  scheduleId String
  cabin      CabinClass
  capacity   Int // base capacity
  sold       Int        @default(0) // source of truth; Redis is cache
  basePrice  Decimal    @db.Decimal(10, 2) // CNY
  // 仓位阶梯（显式动态加价）：有序数组 [{ quota, price }]，最便宜的在前；售罄一档开下一档。
  // null / [] = 未配置阶梯 = 回退旧版 basePrice×日期倍率×余位倍率自动定价。
  fareBuckets Json?     // [{ "quota": 20, "price": 1280 }, ...]（quota int≥1, price≥0）
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  schedule      FlightSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  seatLocks     SeatLock[]
  seatWaitlists SeatWaitlist[]

  @@unique([scheduleId, cabin])
}

// ─────────────────────────────────────────────────────────────────────────────
// Seat Locks — 锁位：下单前临时占座，到期自动释放（status 流转由应用层维护）
// ─────────────────────────────────────────────────────────────────────────────
enum SeatLockStatus {
  ACTIVE
  EXPIRED
  CONSUMED
  RELEASED
}

model SeatLock {
  id               String         @id @default(cuid())
  flightScheduleId String
  seatClassId      String
  userId           String
  qty              Int
  status           SeatLockStatus @default(ACTIVE)
  expiresAt        DateTime
  consumedOrderId  String? // 锁位被哪张订单消费（CONSUMED 时填）
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  flightSchedule FlightSchedule  @relation(fields: [flightScheduleId], references: [id], onDelete: Cascade)
  seatClass      FlightSeatClass @relation(fields: [seatClassId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([flightScheduleId, seatClassId, status])
  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// 候补 — 舱位售罄/余票不足时登记；座位释放后 worker 按先来先到标 NOTIFIED
// ─────────────────────────────────────────────────────────────────────────────
enum WaitlistStatus {
  ACTIVE
  NOTIFIED
  FULFILLED
  CANCELLED
}

model SeatWaitlist {
  id               String         @id @default(cuid())
  flightScheduleId String
  seatClassId      String
  userId           String
  qty              Int
  contactPhone     String
  status           WaitlistStatus @default(ACTIVE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  flightSchedule FlightSchedule  @relation(fields: [flightScheduleId], references: [id], onDelete: Cascade)
  seatClass      FlightSeatClass @relation(fields: [seatClassId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([flightScheduleId, seatClassId, status])
  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// 航班成本周期 — 按 (航班, 日期段) 定包机/机场税；班次的 charterCostCny 等字段
// 仍存在并作为"单班次 override"优先生效（resolution: schedule ?? period ?? null）
// ─────────────────────────────────────────────────────────────────────────────
model FlightCostPeriod {
  id               String   @id @default(cuid())
  flightId         String
  // 周期生效起止日（date-only；按航班出发地时区匹配班次日期）
  effectiveFrom    DateTime @db.Date
  effectiveTo      DateTime @db.Date
  // 周期默认成本（CNY；任一为 null 表示该字段不通过 period 提供，由班次 override 或留空）
  charterCostCny   Decimal? @db.Decimal(12, 2)
  airportTaxDepCny Decimal? @db.Decimal(10, 2)
  airportTaxArrCny Decimal? @db.Decimal(10, 2)
  // 财务追加成本（per-pax CNY；同 FlightSchedule）
  fuelCostCny        Decimal? @db.Decimal(10, 2)
  peakSurchargeCny   Decimal? @db.Decimal(10, 2)
  aircraftAdjustCny  Decimal? @db.Decimal(10, 2)
  takeoffDiscountCny Decimal? @db.Decimal(10, 2)
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@index([flightId, effectiveFrom, effectiveTo])
}

// ─────────────────────────────────────────────────────────────────────────────
// Products — Hotels
// ─────────────────────────────────────────────────────────────────────────────

model Hotel {
  id          String   @id @default(cuid())
  // 产品编号（H0001、H0002...）— 运营/财务对账用；老数据迁移时按 createdAt 回填
  code        String?  @unique
  name        String
  nameEn      String?
  cityCode    String // IATA or internal city code
  area        String? // 区域描述（如"美溪海滩"）
  address     String
  starRating  Int // 1..5
  basePrice   Decimal? @db.Decimal(10, 2) // 起步价（展示用）
  rating      Decimal? @db.Decimal(3, 2) // 客户评分 0-5（兜底展示；真实评分由 Review 聚合覆盖）
  reviewCount Int?
  soldCount   Int      @default(0) // 已售份数（展示用，seed 填充）
  emoji       String?
  highlight   String? // 一句话卖点
  latitude    Decimal? @db.Decimal(9, 6)
  longitude   Decimal? @db.Decimal(9, 6)
  amenities   String[] // e.g., ["wifi", "breakfast", "pool"]
  photos      String[] // S3 URLs
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roomTypes    HotelRoomType[]
  blockPeriods HotelBlockPeriod[]

  @@index([cityCode])
}

// ─────────────────────────────────────────────────────────────────────────────
// 酒店包房周期 — 按日期段向酒店切房（buy-out blocks）；dateFrom/dateTo 闭区间
// ─────────────────────────────────────────────────────────────────────────────
model HotelBlockPeriod {
  id        String   @id @default(cuid())
  hotelId   String
  dateFrom  DateTime @db.Date
  dateTo    DateTime @db.Date // inclusive
  rooms     Int
  unitPrice Decimal? @db.Decimal(12, 2) // 切房单价（CNY/间/晚）
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId, dateFrom, dateTo])
}

model HotelRoomType {
  id              String   @id @default(cuid())
  hotelId         String
  name            String // e.g., "Deluxe King"
  bedType         String? // "1 张大床 · 海景"
  capacity        Int // max guests（总人数上限；保留作为整体容量）
  // 单间可坐几大人 / 几小孩（赵姐："每个酒店房型可以 fit 几大人几小孩"）。
  // 套餐下单时据此算 roomsNeeded = max(ceil(成人/maxAdults), ceil(儿童/maxChildren), 1)，
  // 房间数 >1 时套餐酒店部分按房价 ×roomsNeeded 收费（自动加房收钱）。婴儿不占床。
  maxAdults       Int      @default(2)
  maxChildren     Int      @default(1)
  basePrice       Decimal  @db.Decimal(10, 2)
  // 净房价（CNY/晚）— 付给酒店的真实成本；NULL 时按 basePrice × 0.70 估算
  costPriceCny    Decimal? @db.Decimal(10, 2)
  priceMultiplier Decimal? @db.Decimal(5, 2) // 相对 hotel.basePrice 的倍率（可选，用于 UI 快速报价）
  photos          String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel      Hotel                @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  inventory  HotelRoomInventory[]
  orderItems OrderItem[]
  bundles    Bundle[]

  @@unique([hotelId, name])
}

model HotelRoomInventory {
  id         String   @id @default(cuid())
  roomTypeId String
  date       DateTime @db.Date
  available  Int
  price      Decimal  @db.Decimal(10, 2) // may override basePrice for this date
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roomType HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Products — Transfers & Visas
// ─────────────────────────────────────────────────────────────────────────────

model Transfer {
  id           String   @id @default(cuid())
  // 产品编号（T0001、T0002...）
  code         String?  @unique
  name         String
  vehicleType  String // e.g., "sedan", "suv", "van"
  capacity     Int
  originArea   String
  destArea     String
  basePrice    Decimal  @db.Decimal(10, 2)
  // 司机/车队结算价（CNY）— NULL 时按 basePrice × 0.65 估算
  costPriceCny Decimal? @db.Decimal(10, 2)
  features     String[] // e.g., ["中文司机", "免费等候 60 分钟"]
  duration     String? // "约 15 分钟"
  soldCount    Int      @default(0) // 已售份数（展示用，seed 填充）
  emoji        String?
  photo        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems OrderItem[]
}

model Visa {
  id                 String   @id @default(cuid())
  // 产品编号（V0001、V0002...）
  code               String?  @unique
  destinationCountry String // ISO 3166-1 alpha-2 (e.g., "VN")
  country            String? // 中文国名（"越南"）
  visaType           String // e.g., "tourist", "business"
  visaName           String? // 完整签证名称（"电子签证 E-visa · 30 天单次"）
  flag               String? // emoji flag
  photo              String? // 卡片展示图（URL）
  processingDays     Int
  basePrice          Decimal  @db.Decimal(10, 2)
  expressSurcharge   Decimal? @db.Decimal(10, 2)
  // 使馆/代办成本（CNY）— NULL 时按 basePrice × 0.55 估算（签证毛利通常更高）
  costPriceCny       Decimal? @db.Decimal(10, 2)
  validityMonths     Int? // 签证有效期（月）
  highlight          String? // "最热销 · 全流程线上"
  requiredDocs       String[] // e.g., ["passport_scan", "photo", "itinerary"]
  soldCount          Int      @default(0) // 已售份数（展示用，seed 填充）
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orderItems OrderItem[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Products — Bundles (打包套餐)
// ─────────────────────────────────────────────────────────────────────────────
model Bundle {
  id             String   @id @default(cuid())
  // 产品编号（B0001、B0002...）
  code           String?  @unique
  name           String
  tagline        String?
  emoji          String?
  photo          String?
  // 套餐组件列表（JSON）: [{kind: 'HOTEL', productName, qty, unitPrice}, ...]
  // 注意：FLIGHT 组件的 unitPrice=0，客户端选日期后调 /flights/price 实时取价
  items          Json
  flightPax      Int      @default(1) // 机票组件含多少人
  groundDiscount Decimal  @default(0) @db.Decimal(10, 2) // 地面部分让利（套餐专享优惠）
  suitableFor    String? // "2 人 · 情侣/家庭"
  // 套餐关联酒店房型 — 下单时把房型+入住日期盖到订单行上，房控板自动计入套餐占房
  hotelRoomTypeId String?
  hotelNights     Int? // 默认入住晚数（客户没填回程日期时按 goDate + hotelNights 推 checkOut）
  // 可选升级加价（CNY，按产品可配置；运营在后台改）— 都是 server-priced add-on：
  //   singleSupplementCnyPerNight = 一个人住酒店（单人入住）/晚 的房差，运营默认 ¥80
  //   businessUpgradeCnyPerLeg    = 升舱商务 /航段 的加价，运营默认 ¥700
  // 注意：豪华/五星套餐（洲际半岛、四季）的单人入住房差远高于平价默认值，故 seed 里按产品上调。
  singleSupplementCnyPerNight Int @default(80)
  businessUpgradeCnyPerLeg    Int @default(700)
  // 占座儿童 / 不占座婴儿定价（按产品可配置；运营在后台改）：
  //   childSeatDiscountCnyPerPerson = 占座儿童比成人每人便宜多少 CNY（运营默认 ¥30，可改）
  //   infantPriceCny                = 不占座婴儿每人价 CNY（默认免费 0，可改）
  // 占座儿童与成人同占 1 座（机票按成人价减此折扣）；婴儿不占座、不占房，仍需护照。
  childSeatDiscountCnyPerPerson Int @default(30)
  infantPriceCny                Int @default(0)
  // 自备签证可减额（CNY）：套餐含签证费时，客人自备签证（不需要送签）则从套餐价减此额。
  // 运营在后台改；0 = 不允许减。录单勾"客人自备签证"时由 computeBundleAddOn 扣减。
  selfVisaDeductCny             Int @default(0)
  // 机票航段数（来回 = 2，单程 = 1）— 升舱加价 = businessUpgradeCnyPerLeg × legs × businessCount
  legs           Int      @default(2)
  // 运营封盘日（按出发日 D）：该日整套餐不可售，优先级高于库存判定。
  //   形如 [{date:"2026-02-15", reason:"春节封盘"}]；reason 可选。
  blackoutDates     Json    @default("[]")
  // 该套餐前台默认出发日（YYYY-MM-DD）；null = 用全局默认。
  //   仅影响前台初始选中的出发日，不参与"可售判定"。
  defaultDepartDate String?
  soldCount      Int      @default(0) // 已售份数（展示用，seed 填充）
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hotelRoomType HotelRoomType? @relation(fields: [hotelRoomTypeId], references: [id])
  orderItems    OrderItem[]

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviews — 产品评价（前台展示 + 订单完成后客户提交）
// productId 是 polymorphic：按 productType 指向 Bundle/Hotel/Transfer/Visa.id，
// FLIGHT 评价用航线/航班号字符串做 productId（无强外键，故不建关系）。
// ─────────────────────────────────────────────────────────────────────────────
enum ProductReviewType {
  BUNDLE
  HOTEL
  TRANSFER
  VISA
  FLIGHT
}

model Review {
  id          String            @id @default(cuid())
  productType ProductReviewType
  productId   String
  rating      Int // 1-5
  title       String?
  body        String
  authorName  String // 已脱敏的展示名（"王**"）
  verified    Boolean           @default(false) // true = 来自真实订单
  tripType    String? // 家庭/情侣/朋友/商务
  reply       String? // 商家回复
  orderId     String? // 关联订单（订单后评价时填）
  createdAt   DateTime          @default(now())

  @@index([productType, productId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  TICKETED
  COMPLETED
  PAYMENT_TIMEOUT
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
  CHANGE_REQUESTED
  CHANGED
  FAILED
}

// 订单级签证状态（录单时选择）：不需要 / 需要 / 电子签(三个月多次) / 已签证
enum VisaRequirement {
  NOT_NEEDED // 不需要
  NEEDED // 需要
  E_VISA // 电子签（三个月多次）
  HAS_VISA // 已签证
}

enum OrderItemKind {
  FLIGHT
  HOTEL
  TRANSFER
  VISA
  BUNDLE
  INSURANCE
  FEE // airport construction / fuel surcharge
  DISCOUNT
  GUIDE          // 导游服务费收入（贺帅细分）
  UPGRADE_CHANGE // 升舱 / 改期收入
  OVERSALE       // 超售收入
}

enum InvoiceStatus {
  NONE // 不需要 / 未申请
  REQUESTED // 客户已要求开票
  ISSUED // 已开具
}

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique // human-friendly, e.g., "FTM2026041400001"
  userId           String? // null for guest (no-login) checkout
  agentId          String? // non-null when placed by an agent
  // 游客下单（免登录）联系人 —— userId=null 时用于公开订单查询匹配 + 履约联系
  guestName        String?
  guestPhone       String?
  guestEmail       String?
  status           OrderStatus   @default(DRAFT)
  // 开票状态（运营在订单管理里维护，反馈：李萍）
  invoiceStatus    InvoiceStatus @default(NONE)
  currency         String        @default("CNY")
  subtotal         Decimal       @db.Decimal(12, 2)
  taxesAndFees     Decimal       @default(0) @db.Decimal(12, 2)
  discountTotal    Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  paidAmount       Decimal       @default(0) @db.Decimal(12, 2)
  prepaymentOffset Decimal       @default(0) @db.Decimal(12, 2)
  contactName      String
  contactPhone     String
  contactEmail     String?
  paymentExpiresAt DateTime?
  idempotencyKey   String?       @unique
  notes            String? // 客户填写的特殊说明（兼容保留：老的自由文本备注框）
  internalNotes    String? // 运营/客服内部备忘（客户看不到）
  // 订单级签证状态（录单时选择）
  visaStatus       VisaRequirement?
  // 结构化备注四栏（取代「一个框 + 手工排序」的老做法）；与 notes 并存，互不影响
  noteHotel        String? // 酒店
  noteVisa         String? // 签证
  notePayment      String? // 付款
  noteSpecial      String? // 特殊
  // 防漏单：哪位运营接的单 + 接单时间
  claimedById      String?
  claimedAt        DateTime?
  // 套票拼房分配 — { roomGroups: [{ id, hotelName, roomType, passengerIds: [], notes }] }
  roomAssignment   Json?
  // 出纳：预期到账总额（CNY）+ 锁定标记。锁定后只 ADMIN 能改，避免运营随便改。
  expectedAmountCny    Decimal? @db.Decimal(12, 2)
  expectedAmountLocked Boolean  @default(false)
  // 售后费用（改期费 / 换人费等）：累计客户应补付的金额（CNY，整数）。
  // 应付 = total + adjustmentCny；尾款 = total + adjustmentCny − paidAmount。
  // 不改 total/subtotal（机票基础价不重算），只在结清口径上叠加。
  adjustmentCny    Int           @default(0)
  // 售后费用流水（审计）：[{ type, label, amountCny, at, by }]
  // type ∈ RESCHEDULE_FEE | SWAP_FEE | ...；by = 操作人 userId（无则 null）
  adjustments      Json          @default("[]")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user              User?                 @relation("OrderUser", fields: [userId], references: [id])
  agent             Agent?                @relation(fields: [agentId], references: [id])
  claimedBy         User?                 @relation("OrderClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)
  items             OrderItem[]
  costItems         OrderCostItem[]
  passengers        Passenger[]
  payments          Payment[]
  refunds           Refund[]
  statusEvents      OrderStatusEvent[]
  commissionRecords CommissionRecord[]
  notifications     NotificationLog[]
  reminders         OperationalReminder[]

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([claimedById])
}

model OrderItem {
  id               String        @id @default(cuid())
  orderId          String
  kind             OrderItemKind
  description      String
  quantity         Int           @default(1)
  unitPrice        Decimal       @db.Decimal(10, 2)
  amount           Decimal       @db.Decimal(12, 2)
  // 成本快照（CNY/件）— 下单时锁定的真实采购成本；NULL = 老数据，未回填
  unitCostCny      Decimal?      @db.Decimal(10, 2)
  // 总成本（CNY）= unitCostCny × quantity；NULL = 老数据
  totalCostCny     Decimal?      @db.Decimal(12, 2)
  // Optional links — exactly one set depending on kind.
  flightScheduleId String?
  flightCabin      CabinClass?
  hotelRoomTypeId  String?
  hotelCheckIn     DateTime?     @db.Date
  hotelCheckOut    DateTime?     @db.Date
  transferId       String?
  visaId           String?
  bundleId         String?
  metadata         Json?
  // 计费/占房间数（允许 0.5，用于拼房：7 人 3.5 间、1 人占半间）。
  // NULL = 老数据/未显式分房 → 房控按容量算法或 metadata.roomsNeeded 回落。
  roomsBilled      Decimal?      @db.Decimal(4, 1)
  createdAt        DateTime      @default(now())

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  flightSchedule   FlightSchedule?   @relation(fields: [flightScheduleId], references: [id])
  hotelRoomType    HotelRoomType?    @relation(fields: [hotelRoomTypeId], references: [id])
  transfer         Transfer?         @relation(fields: [transferId], references: [id])
  visa             Visa?             @relation(fields: [visaId], references: [id])
  bundle           Bundle?           @relation(fields: [bundleId], references: [id])
  fulfillmentTasks FulfillmentTask[]

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// 订单杂项成本 — 财务录入的订单级成本明细（贺帅细分：导游/赠送/手续费/操作费/其他）
// 跟 OrderItem 区分：OrderItem 是面向客户的商品行；OrderCostItem 是后台财务的成本明细
// 一张订单可有 N 条（一类可多条）
// ─────────────────────────────────────────────────────────────────────────────
enum OrderCostCategory {
  GUIDE_SERVICE // 导游服务费
  COMP_GIFT     // 赠送费用
  HANDLING_FEE  // 手续费
  OPERATION_FEE // 操作费（订单录入/服务人员费，每单固定）
  OTHER         // 其他
}

model OrderCostItem {
  id        String            @id @default(cuid())
  orderId   String
  category  OrderCostCategory
  amountCny Decimal           @db.Decimal(12, 2)
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, category])
}

// ─────────────────────────────────────────────────────────────────────────────
// Fulfillment Tasks — 出票 / 酒店确认 / 签证进度 / 司机调度
// ─────────────────────────────────────────────────────────────────────────────
enum FulfillmentType {
  FLIGHT_TICKETING // 出票（PNR + e-ticket number）
  HOTEL_BOOKING // 酒店预订（confirmation number）
  VISA_APPLICATION // 签证申请（application number + progress）
  TRANSFER_DISPATCH // 接送调度（driver + vehicle）
  BUNDLE_COMPOSITE // 套餐：需拆解为多个子任务
}

enum FulfillmentStatus {
  PENDING
  IN_PROGRESS
  CONFIRMED
  CANCELLED
  FAILED
}

model FulfillmentTask {
  id             String            @id @default(cuid())
  orderItemId    String
  type           FulfillmentType
  status         FulfillmentStatus @default(PENDING)
  // 多态 data：FLIGHT → {pnr, eTicketNumber}
  //            HOTEL  → {confirmationNumber}
  //            VISA   → {applicationNumber, progress}
  //            TRANSFER → {driverName, vehicleNumber}
  data           Json?
  notes          String?
  attempts       Int               @default(0)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  failureReason  String?
  assigneeUserId String? // 谁负责这条任务
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([status])
  @@index([type, status])
}

model Passenger {
  id             String        @id @default(cuid())
  orderId        String
  fullName       String
  // 航司 PNR 标准字段：姓 / 名 拆开（fullName 仍保留兼容）
  lastName       String?
  firstName      String?
  title          String? // MR / MRS / MS / MSTR / MISS
  gender         Gender?
  documentType   DocumentType
  documentNumber String
  dateOfBirth    DateTime
  placeOfBirth   String?
  nationality    String
  passengerType  PassengerType @default(ADULT)

  // ── 护照扩展（出票 + 签证用）──
  chineseName          String?   // 中文姓名（OCR 识别或手工填写）
  passportIssueDate    DateTime? @db.Date // 护照签发日期
  passportIssueCountry String? // 颁发国 ISO-2，如 CHN
  passportExpiry       DateTime? @db.Date

  // ── 签证（已签发的，给出票/接送参考）──
  visaNumber               String?
  visaType                 String? // E-visa / Sticker / Approval letter
  visaIssueDate            DateTime? @db.Date
  visaExpiry               DateTime? @db.Date
  visaPlaceOfIssue         String?
  visaCountryOfApplication String?

  // ── 地址（航司提交格式需要）──
  addressType    String? // BUSINESS / RESIDENTIAL
  addressDetails String? // 详细地址
  addressCity    String?
  addressState   String?
  addressCountry String? // ISO-2
  addressZip     String?

  mealPreference      String?
  needsWheelchair     Boolean @default(false)
  needsInfantBassinet Boolean @default(false)
  // 拼房用 — 客人偏好：SINGLE/DOUBLE/TWIN/SHARE_OK
  bedPref             String?
  // 护照照片（OCR 上传或人工补传）
  passportPhotoUrl    String?

  pnr           String? // booked PNR from airline
  eticketNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderStatusEvent {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?
  reason      String?
  metadata    Json?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([orderId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentMethod {
  WECHAT_PAY
  ALIPAY
  BANK_CARD
  AGENT_PREPAYMENT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  transactionId  String?       @unique // gateway transaction id
  idempotencyKey String?       @unique // 人工确认收款幂等键：同 key 重试只入账一次
  gatewayPayload Json?
  // 人工确认收款上传的截图（data URL；线下收款凭证）
  proofUrl       String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// 统一收款 + 收款对账台 + 挂账池（Receipts / Reconciliation / Suspense pool）
//
// 公司用统一收款码收钱（微信/支付宝/银行），客服/财务在后台手动对账：
//   - 客户下单后看到统一收款码 + 应付金额，可上传付款凭证（仅"声明"，不直接入账）
//   - 财务在后台登记进账（Receipt），再手动认领（allocate）到订单或退款
//   - 暂时认不出是哪单的钱，先进"挂账池"（status=OPEN 的 Receipt），财务再处理
//   - 订单超额的钱也可放挂账池（source=ORDER_OVERPAY）
//
// 一笔 Receipt 可被拆成多笔 ReceiptAllocation 认领到不同订单；
// 每次认领复用人工确认收款的入账内核（PaymentsService 内 within-tx 变体），
// 因此认领 = 给订单累加 paidAmount + 全额自动翻 PAID + 审计，和直接确认收款口径完全一致。
// ─────────────────────────────────────────────────────────────────────────────

// 统一收款渠道（收款码 / 收款账户），供客户付款页展示。
model PaymentChannel {
  id          String   @id @default(cuid())
  kind        String // WECHAT | ALIPAY | BANK
  label       String // 展示名，如「微信收款码」「公司对公账户」
  qrImageUrl  String?  @db.Text // 收款码图片（data URL，≤6MB）
  accountText String?  @db.Text // 账户信息文本（开户行/账号/户名等）
  note        String?  @db.Text // 备注（如「请备注订单号」）
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// 进账（挂账池）状态。
enum ReceiptStatus {
  OPEN // 未认领（在挂账池里）
  PARTIALLY_ALLOCATED // 部分已认领
  ALLOCATED // 已全部认领
  REFUNDED // 剩余未认领部分已退款
}

// 进账来源。
enum ReceiptSource {
  CUSTOMER_UPLOAD // 客户上传付款凭证（仅声明）
  STAFF_ENTRY // 财务/客服后台登记
  ORDER_OVERPAY // 订单超额转入挂账池
}

// 一笔到账（统一收款码收到的钱）。
model Receipt {
  id           String        @id @default(cuid())
  receiptNo    String        @unique // 人类可读，如「RCP2026061800001」
  amountCny    Decimal       @db.Decimal(14, 2) // 到账总额
  allocatedCny Decimal       @default(0) @db.Decimal(14, 2) // 已认领额（remaining = amount − allocated）
  method       PaymentMethod
  proofUrl     String?       @db.Text // 付款凭证截图（data URL，≤6MB）
  payerNote    String? // 付款人备注（客户填的订单号/留言）
  orderHintId  String? // 疑似归属订单（客户上传时带的；仅提示，不等于已认领）
  receivedAt   DateTime // 到账时间（财务可手填）
  source       ReceiptSource
  status       ReceiptStatus @default(OPEN)
  refundNote   String? // 退款备注（仅 REFUNDED 时）
  createdById  String? // 登记人 userId（系统/客户上传时为 null）
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  allocations ReceiptAllocation[]

  @@index([status])
  @@index([receivedAt])
  @@index([orderHintId])
}

// 一笔进账认领到某订单的记录（一笔进账可拆多条认领到不同订单）。
model ReceiptAllocation {
  id          String   @id @default(cuid())
  receiptId   String
  orderId     String
  amountCny   Decimal  @db.Decimal(14, 2)
  createdById String?
  createdAt   DateTime @default(now())

  receipt Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([orderId])
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

model Refund {
  id             String       @id @default(cuid())
  orderId        String
  amount         Decimal      @db.Decimal(12, 2)
  reason         String?
  status         RefundStatus @default(REQUESTED)
  processedAt    DateTime?
  gatewayPayload Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Pricing
// ─────────────────────────────────────────────────────────────────────────────

model PricingConfig {
  id                 String   @id @default(cuid())
  flightScheduleId   String   @unique
  // JSON: [{tier: "A", minDaysOut: 30, minLoadFactor: 0, multiplier: 1.0}, ...]
  tiers              Json
  // optional ML-derived demand multiplier, refreshed weekly
  mlDemandMultiplier Decimal? @db.Decimal(6, 4)
  updatedAt          DateTime @updatedAt

  flightSchedule FlightSchedule @relation(fields: [flightScheduleId], references: [id], onDelete: Cascade)
  overrides      TierOverride[]
  priceHistory   PriceHistory[]
}

model TierOverride {
  id              String    @id @default(cuid())
  pricingConfigId String
  tier            String // "A" | "B" | "C" | "D"
  multiplier      Decimal   @db.Decimal(6, 4)
  reason          String?
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdById     String
  createdAt       DateTime  @default(now())

  pricingConfig PricingConfig @relation(fields: [pricingConfigId], references: [id], onDelete: Cascade)

  @@index([pricingConfigId, effectiveFrom])
}

model PriceHistory {
  id              String     @id @default(cuid())
  pricingConfigId String
  cabin           CabinClass
  price           Decimal    @db.Decimal(10, 2)
  tier            String
  observedAt      DateTime   @default(now())

  pricingConfig PricingConfig @relation(fields: [pricingConfigId], references: [id], onDelete: Cascade)

  @@index([pricingConfigId, observedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cancellation policies — 取消订单的退款手续费阶梯
// ─────────────────────────────────────────────────────────────────────────────
//
// tiers JSON 形如：
//   [
//     { "hoursBeforeDeparture": 168, "feePercent": 0   },  // 7+ 天，免费
//     { "hoursBeforeDeparture": 72,  "feePercent": 20  },  // 3-7 天，20% 手续费
//     { "hoursBeforeDeparture": 24,  "feePercent": 50  },  // 1-3 天，50%
//     { "hoursBeforeDeparture": 0,   "feePercent": 80  },  // <1 天，80%
//     { "hoursBeforeDeparture": -1,  "feePercent": 100 }   // 已起飞 / 已入住，100%
//   ]
//
// 找匹配 tier 算法：取 hoursLeft >= tier.hoursBeforeDeparture 中 hoursBeforeDeparture 最大的一档；
// 都不满足（i.e. 已过 0 小时）→ 取 hoursBeforeDeparture = -1 那条（"已履约"档）。
//
// 优先级：scope 精确匹配 > 同 productKind 的 isDefault=true。
//
model CancellationPolicy {
  id          String        @id @default(cuid())
  productKind OrderItemKind
  // 可选范围限定（null = 该 kind 的通用策略；非 null = 针对特定班次/酒店房型/套餐）
  // scope 是 polymorphic，按 productKind 解释：FLIGHT→FlightSchedule.id, HOTEL→HotelRoomType.id, BUNDLE→Bundle.id ...
  scope       String?
  name        String // 人类可读，例 "默认机票退订" / "国庆班次特殊政策"
  tiers       Json // 见上方注释；运行时校验 hoursBeforeDeparture 单调递减、feePercent 0-100
  isDefault   Boolean       @default(false) // true = 该 kind 的兜底；同 kind 只允许一条 isDefault
  isActive    Boolean       @default(true)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([productKind, scope]) // 同 kind+scope 唯一
  @@index([productKind, isDefault])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  SMS
  EMAIL
  WECHAT
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  RETRYING
}

model NotificationLog {
  id           String              @id @default(cuid())
  orderId      String?
  userId       String?
  channel      NotificationChannel
  recipient    String // phone, email, or openid
  template     String // template key
  payload      Json
  status       NotificationStatus  @default(QUEUED)
  attemptCount Int                 @default(0)
  lastError    String?
  sentAt       DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  order Order? @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Dynamic Pricing — Date Ranking
// ─────────────────────────────────────────────────────────────────────────────

/// 日期等级表 — 每天一行 (A/B/C/D)。Seed 自动按 DOW 填充，admin 可手动 override。
model DateRanking {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date // 出发本地日期（UTC midnight 存）
  rank      String // "A" | "B" | "C" | "D"
  reason    String? // "春节" | "default:Friday" | "manual override"
  isManual  Boolean  @default(false) // true = admin 手动覆盖
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Operational Reminders（操作部待办/特殊提醒）
// 用户场景：签证截止前要送批文；出票前要拿酒店单过海关；客人特殊改期
// ─────────────────────────────────────────────────────────────────────────────
model OperationalReminder {
  id            String           @id @default(cuid())
  orderId       String? // 可选关联订单（独立待办则为 null）
  createdById   String // 提单人
  claimedById   String? // 认领人（null = 未认领）
  title         String // 一句话标题
  body          String? // 详细说明
  dueAt         DateTime?        @db.Date
  priority      ReminderPriority @default(NORMAL)
  status        ReminderStatus   @default(OPEN)
  attachmentUrl String? // 截图 / 文件链接（小程序/客人发来的）
  resolvedAt    DateTime?
  resolvedNote  String? // 完成或跳过的说明
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  order     Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User   @relation("ReminderCreator", fields: [createdById], references: [id])
  claimedBy User?  @relation("ReminderClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status, priority, dueAt])
  @@index([claimedById, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI OCR 配置 — 单例表（最多一行），存后台粘贴的 Qwen-VL API Key
// 读取优先级：DB > env（DASHSCOPE_API_KEY / QWEN_BASE_URL / QWEN_VL_MODEL）
// ─────────────────────────────────────────────────────────────────────────────
model AiOcrConfig {
  id          String   @id @default(cuid())
  provider    String   @default("QWEN")
  apiKey      String?  // 明文存库；序列化给前端时打码（不返回原文）
  baseUrl     String?
  model       String?
  enabled     Boolean  @default(true)
  updatedById String? // 最后修改人 userId
  updatedAt   DateTime @updatedAt
}
