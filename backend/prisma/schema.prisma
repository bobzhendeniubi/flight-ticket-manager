// Flight Ticket Manager — Prisma schema
// Covers M1 issue #1: PostgreSQL multi-schema design (Redis/OpenSearch handled at app layer).
// All ids are cuid() strings; timestamps are UTC; monetary amounts are Decimal(12, 2) CNY.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  AGENT
  STAFF
  ADMIN
}

enum DocumentType {
  ID_CARD // 居民身份证
  PASSPORT
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

model User {
  id             String    @id @default(cuid())
  email          String?   @unique
  phone          String?   @unique
  passwordHash   String?   // null for WeChat-only users
  role           UserRole  @default(CUSTOMER)
  displayName    String?
  emailVerified  Boolean   @default(false)
  phoneVerified  Boolean   @default(false)
  wechatOpenId   String?   @unique
  wechatUnionId  String?   @unique
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  refreshTokens    RefreshToken[]
  savedPassengers  SavedPassenger[]
  orders           Order[]
  agentProfile     Agent?
  orderEvents      OrderStatusEvent[]
  customerProfile  CustomerProfile?
  auditLogs        AuditLog[]

  @@index([role])
  @@index([createdAt])
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique // sha256 of the refresh token
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SavedPassenger {
  id             String        @id @default(cuid())
  userId         String
  fullName       String
  documentType   DocumentType
  documentNumber String
  dateOfBirth    DateTime
  nationality    String        // ISO 3166-1 alpha-2 (e.g., CN, US)
  passengerType  PassengerType @default(ADULT)
  phone          String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, documentNumber])
  @@index([userId])
  @@index([fullName])
  @@index([dateOfBirth])
}

// ─────────────────────────────────────────────────────────────────────────────
// Customer Profile — 客户画像（User.role=CUSTOMER 的扩展信息）
// ─────────────────────────────────────────────────────────────────────────────
model CustomerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  idNumber       String?  // 身份证/护照号
  primaryAgentId String?  // 归属代理（null = 直销散客）
  tags           String[] // ["VIP", "回头客", "蜜月"]
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryAgent Agent? @relation(fields: [primaryAgentId], references: [id])

  @@index([primaryAgentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit Log — 全站敏感操作留痕
// ─────────────────────────────────────────────────────────────────────────────
enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AuditTargetType {
  AGENT
  ORDER
  FLIGHT
  CUSTOMER
  TRAVELER
  PRICING
  COMMISSION
  SETTLEMENT
  PRODUCT
  AUTH
  SYSTEM
}

model AuditLog {
  id          String           @id @default(cuid())
  actorUserId String?          // null = 系统操作（定时任务等）
  actorLabel  String?          // 缓存的 email/displayName（防用户删除后丢信息）
  actorRole   String?
  action      String           // CREATE_AGENT / UPDATE_PRICING / ADVANCE_ORDER_STATUS ...
  targetType  AuditTargetType
  targetId    String?
  targetLabel String?          // 人类可读的对象名称
  before      Json?
  after       Json?
  severity    AuditSeverity    @default(INFO)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime         @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([severity])
}

// ─────────────────────────────────────────────────────────────────────────────
// Agents
// ─────────────────────────────────────────────────────────────────────────────

model Agent {
  id                 String   @id @default(cuid())
  userId             String   @unique
  companyName        String?
  contactName        String
  contactPhone       String
  prepaymentBalance  Decimal  @default(0) @db.Decimal(14, 2) // CNY, can be negative only by admin override
  isActive           Boolean  @default(true)
  notes              String?
  // 代理层级 — 1 级代理 parentAgentId = null；上级创建下级时 tier = parent.tier + 1
  parentAgentId      String?
  tier               Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentAgent            Agent?                  @relation("AgentHierarchy", fields: [parentAgentId], references: [id])
  childAgents            Agent[]                 @relation("AgentHierarchy")
  prepaymentTransactions PrepaymentTransaction[]
  commissionRules        CommissionRule[]
  commissionRecords      CommissionRecord[]
  settlements            Settlement[]
  orders                 Order[]
  customers              CustomerProfile[]

  @@index([isActive])
  @@index([parentAgentId])
  @@index([tier])
}

enum PrepaymentTxType {
  TOP_UP
  OFFSET // used on an order
  ADJUSTMENT // admin manual adjustment
  REFUND // returned from a cancelled order
}

model PrepaymentTransaction {
  id          String           @id @default(cuid())
  agentId     String
  amount      Decimal          @db.Decimal(14, 2) // positive = credit, negative = debit
  balanceAfter Decimal         @db.Decimal(14, 2)
  type        PrepaymentTxType
  orderId     String?          // set when tied to an order
  description String?
  createdById String           // user id of the admin/agent/system actor
  createdAt   DateTime         @default(now())

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
  @@index([orderId])
}

enum ProductKind {
  FLIGHT
  HOTEL
  TRANSFER
  VISA
}

model CommissionRule {
  id          String      @id @default(cuid())
  agentId     String
  productKind ProductKind
  // commission rate as a decimal fraction, e.g. 0.0500 = 5.00%
  rate        Decimal     @db.Decimal(6, 4)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, productKind, effectiveFrom])
  @@index([agentId])
}

enum CommissionStatus {
  ACCRUED
  SETTLEMENT_REQUESTED
  SETTLED
  REVERSED
}

model CommissionRecord {
  id          String           @id @default(cuid())
  agentId     String
  orderId     String
  productKind ProductKind
  baseAmount  Decimal          @db.Decimal(12, 2) // the order item amount commission is computed on
  rate        Decimal          @db.Decimal(6, 4)  // net rate (this_agent.rate - child.rate if in chain)
  amount      Decimal          @db.Decimal(12, 2) // baseAmount * rate
  status      CommissionStatus @default(ACCRUED)
  // 0=seller, 1=seller's parent, 2=grandparent ... 用于结算时计算 "commissionPaidToChildren"
  chainDepth  Int              @default(0)
  settlementId String?         // nullable until included in a settlement
  settledAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  agent      Agent       @relation(fields: [agentId], references: [id])
  order      Order       @relation(fields: [orderId], references: [id])
  settlement Settlement? @relation(fields: [settlementId], references: [id])

  @@index([agentId, status])
  @@index([orderId])
  @@index([settlementId])
  // 结算热路径：按 (agentId, status, createdAt) 查本期 ACCRUED
  @@index([agentId, status, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Settlement — 月度结算单，每个代理每月 1 张
// ─────────────────────────────────────────────────────────────────────────────
enum SettlementStatus {
  DRAFT              // 生成后的初始状态
  PENDING_APPROVAL   // 提交审核
  APPROVED           // 管理员核准，待支付
  PAID               // 已支付给代理（CommissionRecord → SETTLED，prepaymentOffset 已扣）
  VOIDED             // 作废（比如重算）
}

model Settlement {
  id                        String           @id @default(cuid())
  period                    String           // YYYY-MM
  agentId                   String
  orderCount                Int              @default(0)
  grossRevenue              Decimal          @db.Decimal(14, 2) @default(0)
  commissionEarned          Decimal          @db.Decimal(14, 2) @default(0)
  commissionPaidToChildren  Decimal          @db.Decimal(14, 2) @default(0)
  netCommission             Decimal          @db.Decimal(14, 2) @default(0)
  prepaymentOffset          Decimal          @db.Decimal(14, 2) @default(0)
  payableToAgent            Decimal          @db.Decimal(14, 2) @default(0)
  status                    SettlementStatus @default(DRAFT)
  generatedAt               DateTime         @default(now())
  approvedAt                DateTime?
  paidAt                    DateTime?
  notes                     String?
  updatedAt                 DateTime         @updatedAt

  agent       Agent              @relation(fields: [agentId], references: [id])
  commissions CommissionRecord[]

  @@unique([period, agentId])
  @@index([period])
  @@index([status])
  @@index([agentId, period])
}

// ─────────────────────────────────────────────────────────────────────────────
// Products — Flights
// ─────────────────────────────────────────────────────────────────────────────

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

model Flight {
  id              String    @id @default(cuid())
  flightNumber    String    // e.g., "CA1234"
  originCode      String    // IATA code, e.g., "PEK"
  destinationCode String    // IATA code
  originTerminal  String?
  destTerminal    String?
  aircraftType    String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  schedules FlightSchedule[]

  @@unique([flightNumber])
  @@index([originCode, destinationCode])
}

model FlightSchedule {
  id              String    @id @default(cuid())
  flightId        String
  departureTime   DateTime  // UTC
  arrivalTime     DateTime  // UTC
  departureTz     String    // IANA tz, e.g., "Asia/Shanghai"
  arrivalTz       String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  flight       Flight             @relation(fields: [flightId], references: [id], onDelete: Cascade)
  seatClasses  FlightSeatClass[]
  orderItems   OrderItem[]
  pricingConfig PricingConfig?

  @@index([flightId, departureTime])
  @@index([departureTime])
}

model FlightSeatClass {
  id          String     @id @default(cuid())
  scheduleId  String
  cabin       CabinClass
  capacity    Int        // base capacity
  sold        Int        @default(0) // source of truth; Redis is cache
  basePrice   Decimal    @db.Decimal(10, 2) // CNY
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  schedule FlightSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, cabin])
}

// ─────────────────────────────────────────────────────────────────────────────
// Products — Hotels
// ─────────────────────────────────────────────────────────────────────────────

model Hotel {
  id          String    @id @default(cuid())
  name        String
  nameEn      String?
  cityCode    String    // IATA or internal city code
  area        String?   // 区域描述（如"美溪海滩"）
  address     String
  starRating  Int       // 1..5
  basePrice   Decimal?  @db.Decimal(10, 2) // 起步价（展示用）
  rating      Decimal?  @db.Decimal(3, 2)  // 客户评分 0-5
  reviewCount Int?
  emoji       String?
  highlight   String?   // 一句话卖点
  latitude    Decimal?  @db.Decimal(9, 6)
  longitude   Decimal?  @db.Decimal(9, 6)
  amenities   String[]  // e.g., ["wifi", "breakfast", "pool"]
  photos      String[]  // S3 URLs
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  roomTypes HotelRoomType[]

  @@index([cityCode])
}

model HotelRoomType {
  id              String   @id @default(cuid())
  hotelId         String
  name            String   // e.g., "Deluxe King"
  bedType         String?  // "1 张大床 · 海景"
  capacity        Int      // max guests
  basePrice       Decimal  @db.Decimal(10, 2)
  priceMultiplier Decimal? @db.Decimal(5, 2)  // 相对 hotel.basePrice 的倍率（可选，用于 UI 快速报价）
  photos          String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel       Hotel                 @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  inventory   HotelRoomInventory[]
  orderItems  OrderItem[]

  @@unique([hotelId, name])
}

model HotelRoomInventory {
  id          String   @id @default(cuid())
  roomTypeId  String
  date        DateTime @db.Date
  available   Int
  price       Decimal  @db.Decimal(10, 2) // may override basePrice for this date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roomType HotelRoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  @@unique([roomTypeId, date])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Products — Transfers & Visas
// ─────────────────────────────────────────────────────────────────────────────

model Transfer {
  id            String   @id @default(cuid())
  name          String
  vehicleType   String   // e.g., "sedan", "suv", "van"
  capacity      Int
  originArea    String
  destArea      String
  basePrice     Decimal  @db.Decimal(10, 2)
  features      String[] // e.g., ["中文司机", "免费等候 60 分钟"]
  duration      String?  // "约 15 分钟"
  emoji         String?
  photo         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderItems OrderItem[]
}

model Visa {
  id                 String   @id @default(cuid())
  destinationCountry String   // ISO 3166-1 alpha-2 (e.g., "VN")
  country            String?  // 中文国名（"越南"）
  visaType           String   // e.g., "tourist", "business"
  visaName           String?  // 完整签证名称（"电子签证 E-visa · 30 天单次"）
  flag               String?  // emoji flag
  processingDays     Int
  basePrice          Decimal  @db.Decimal(10, 2)
  expressSurcharge   Decimal? @db.Decimal(10, 2)
  validityMonths     Int?     // 签证有效期（月）
  highlight          String?  // "最热销 · 全流程线上"
  requiredDocs       String[] // e.g., ["passport_scan", "photo", "itinerary"]
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orderItems OrderItem[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Products — Bundles (打包套餐)
// ─────────────────────────────────────────────────────────────────────────────
model Bundle {
  id              String   @id @default(cuid())
  name            String
  tagline         String?
  emoji           String?
  photo           String?
  // 套餐组件列表（JSON）: [{kind: 'HOTEL', productName, qty, unitPrice}, ...]
  // 注意：FLIGHT 组件的 unitPrice=0，客户端选日期后调 /flights/price 实时取价
  items           Json
  flightPax       Int      @default(1)   // 机票组件含多少人
  groundDiscount  Decimal  @db.Decimal(10, 2) @default(0) // 地面部分让利（套餐专享优惠）
  suitableFor     String?  // "2 人 · 情侣/家庭"
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems OrderItem[]

  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────────────────────

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  TICKETED
  COMPLETED
  PAYMENT_TIMEOUT
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
  CHANGE_REQUESTED
  CHANGED
  FAILED
}

enum OrderItemKind {
  FLIGHT
  HOTEL
  TRANSFER
  VISA
  BUNDLE
  INSURANCE
  FEE // airport construction / fuel surcharge
  DISCOUNT
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // human-friendly, e.g., "FTM2026041400001"
  userId          String
  agentId         String?     // non-null when placed by an agent
  status          OrderStatus @default(DRAFT)
  currency        String      @default("CNY")
  subtotal        Decimal     @db.Decimal(12, 2)
  taxesAndFees    Decimal     @db.Decimal(12, 2) @default(0)
  discountTotal   Decimal     @db.Decimal(12, 2) @default(0)
  total           Decimal     @db.Decimal(12, 2)
  paidAmount      Decimal     @db.Decimal(12, 2) @default(0)
  prepaymentOffset Decimal    @db.Decimal(12, 2) @default(0)
  contactName     String
  contactPhone    String
  contactEmail    String?
  paymentExpiresAt DateTime?
  idempotencyKey  String?     @unique
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  agent             Agent?             @relation(fields: [agentId], references: [id])
  items             OrderItem[]
  passengers        Passenger[]
  payments          Payment[]
  refunds           Refund[]
  statusEvents      OrderStatusEvent[]
  commissionRecords CommissionRecord[]
  notifications     NotificationLog[]

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String         @id @default(cuid())
  orderId     String
  kind        OrderItemKind
  description String
  quantity    Int            @default(1)
  unitPrice   Decimal        @db.Decimal(10, 2)
  amount      Decimal        @db.Decimal(12, 2)
  // Optional links — exactly one set depending on kind.
  flightScheduleId String?
  flightCabin      CabinClass?
  hotelRoomTypeId  String?
  hotelCheckIn     DateTime?   @db.Date
  hotelCheckOut    DateTime?   @db.Date
  transferId       String?
  visaId           String?
  bundleId         String?
  metadata         Json?
  createdAt        DateTime    @default(now())

  order            Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  flightSchedule   FlightSchedule?    @relation(fields: [flightScheduleId], references: [id])
  hotelRoomType    HotelRoomType?     @relation(fields: [hotelRoomTypeId], references: [id])
  transfer         Transfer?          @relation(fields: [transferId], references: [id])
  visa             Visa?              @relation(fields: [visaId], references: [id])
  bundle           Bundle?            @relation(fields: [bundleId], references: [id])
  fulfillmentTasks FulfillmentTask[]

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Fulfillment Tasks — 出票 / 酒店确认 / 签证进度 / 司机调度
// ─────────────────────────────────────────────────────────────────────────────
enum FulfillmentType {
  FLIGHT_TICKETING   // 出票（PNR + e-ticket number）
  HOTEL_BOOKING      // 酒店预订（confirmation number）
  VISA_APPLICATION   // 签证申请（application number + progress）
  TRANSFER_DISPATCH  // 接送调度（driver + vehicle）
  BUNDLE_COMPOSITE   // 套餐：需拆解为多个子任务
}

enum FulfillmentStatus {
  PENDING
  IN_PROGRESS
  CONFIRMED
  CANCELLED
  FAILED
}

model FulfillmentTask {
  id           String              @id @default(cuid())
  orderItemId  String
  type         FulfillmentType
  status       FulfillmentStatus   @default(PENDING)
  // 多态 data：FLIGHT → {pnr, eTicketNumber}
  //            HOTEL  → {confirmationNumber}
  //            VISA   → {applicationNumber, progress}
  //            TRANSFER → {driverName, vehicleNumber}
  data         Json?
  notes        String?
  attempts     Int                 @default(0)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  failureReason String?
  assigneeUserId String?           // 谁负责这条任务
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([status])
  @@index([type, status])
}

model Passenger {
  id             String        @id @default(cuid())
  orderId        String
  fullName       String
  documentType   DocumentType
  documentNumber String
  dateOfBirth    DateTime
  nationality    String
  passengerType  PassengerType @default(ADULT)
  mealPreference String?
  needsWheelchair Boolean      @default(false)
  needsInfantBassinet Boolean  @default(false)
  pnr            String?       // booked PNR from airline
  eticketNumber  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderStatusEvent {
  id          String      @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?
  reason      String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([orderId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payments
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentMethod {
  WECHAT_PAY
  ALIPAY
  BANK_CARD
  AGENT_PREPAYMENT
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  transactionId  String?       @unique // gateway transaction id
  gatewayPayload Json?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

enum RefundStatus {
  REQUESTED
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

model Refund {
  id            String       @id @default(cuid())
  orderId       String
  amount        Decimal      @db.Decimal(12, 2)
  reason        String?
  status        RefundStatus @default(REQUESTED)
  processedAt   DateTime?
  gatewayPayload Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Pricing
// ─────────────────────────────────────────────────────────────────────────────

model PricingConfig {
  id                  String   @id @default(cuid())
  flightScheduleId    String   @unique
  // JSON: [{tier: "A", minDaysOut: 30, minLoadFactor: 0, multiplier: 1.0}, ...]
  tiers               Json
  // optional ML-derived demand multiplier, refreshed weekly
  mlDemandMultiplier  Decimal? @db.Decimal(6, 4)
  updatedAt           DateTime @updatedAt

  flightSchedule FlightSchedule @relation(fields: [flightScheduleId], references: [id], onDelete: Cascade)
  overrides      TierOverride[]
  priceHistory   PriceHistory[]
}

model TierOverride {
  id              String   @id @default(cuid())
  pricingConfigId String
  tier            String   // "A" | "B" | "C" | "D"
  multiplier      Decimal  @db.Decimal(6, 4)
  reason          String?
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  createdById     String
  createdAt       DateTime @default(now())

  pricingConfig PricingConfig @relation(fields: [pricingConfigId], references: [id], onDelete: Cascade)

  @@index([pricingConfigId, effectiveFrom])
}

model PriceHistory {
  id              String   @id @default(cuid())
  pricingConfigId String
  cabin           CabinClass
  price           Decimal  @db.Decimal(10, 2)
  tier            String
  observedAt      DateTime @default(now())

  pricingConfig PricingConfig @relation(fields: [pricingConfigId], references: [id], onDelete: Cascade)

  @@index([pricingConfigId, observedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  SMS
  EMAIL
  WECHAT
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  RETRYING
}

model NotificationLog {
  id          String              @id @default(cuid())
  orderId     String?
  userId      String?
  channel     NotificationChannel
  recipient   String              // phone, email, or openid
  template    String              // template key
  payload     Json
  status      NotificationStatus  @default(QUEUED)
  attemptCount Int                @default(0)
  lastError   String?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  order Order? @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Dynamic Pricing — Date Ranking
// ─────────────────────────────────────────────────────────────────────────────

/// 日期等级表 — 每天一行 (A/B/C/D)。Seed 自动按 DOW 填充，admin 可手动 override。
model DateRanking {
  id       String   @id @default(cuid())
  date     DateTime @unique @db.Date // 出发本地日期（UTC midnight 存）
  rank     String   // "A" | "B" | "C" | "D"
  reason   String?  // "春节" | "default:Friday" | "manual override"
  isManual Boolean  @default(false) // true = admin 手动覆盖
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}
