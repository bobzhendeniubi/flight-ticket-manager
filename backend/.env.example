# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres (matches docker-compose defaults)
DATABASE_URL=postgresql://ftm:ftm_dev_password@localhost:5432/ftm?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# CORS (comma-separated origins, or * for all in dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# WeChat OAuth (fill in M2 when WeChat service account is provisioned)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# AWS / S3 (fill in M2+ when infra is provisioned)
AWS_REGION=
S3_BUCKET_UPLOADS=

# Flight inventory: max allowed oversell when lowering schedule capacity below sold
# (capacity can go below sold — airline downgauge/aircraft swap — but oversold seats
# beyond this cap are rejected to guard against fat-fingered capacity edits)
FLIGHT_MAX_OVERSELL_SEATS=5

# Flight inventory: max oversell allowed when restoring a no-show'd return leg
# (the seat was released back to inventory and may already be resold; restoring is
# allowed to go negative on remaining seats, but not beyond this cap)
FLIGHT_NOSHOW_MAX_OVERSELL_SEATS=5

# ── AI（全部走阿里云 DashScope 国际站，一把 key 通用）────────────────
# 为什么不用 OpenAI：生产服务器在香港，OpenAI 对该地区返 403
# unsupported_country_region_territory，直连不可用。
# 申请：https://dashscope.console.aliyun.com → API-KEY 管理
# ⚠️ sk-ws- 开头是国际版 key，必须配国际站端点（dashscope-intl），否则 401。
#
# ⚠️ 本机开发注意：若 shell（~/.zshenv 等）里 export 过 OPENAI_API_KEY，
#    它会静默覆盖本文件 —— dotenv 默认不覆盖已存在的 process.env。
#    启动日志「🤖 AI 已启用」会打印实际生效的 model / baseUrl / key 长度，对不上就是被覆盖了。

# 对话（OpenAI 兼容协议，变量名沿用 OPENAI_* 前缀）
OPENAI_API_KEY=
OPENAI_MODEL=qwen3-max
OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 证件 OCR（视觉模型，与上面同一把 key）
DASHSCOPE_API_KEY=
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 营销海报服务端叠字字体（可选；不填时按 Alpine/macOS 固定路径探测）
# POSTER_FONT_PATH=/usr/share/fonts/noto/NotoSansCJK-Regular.ttc

# 营销海报生图模型与每日配额（修改后需重启 backend）
# qwen-image-2.0-pro / qwen-image-2.0-*：同步 multimodal-generation，实测约 10 秒
# qwen-image-max / qwen-image-plus：同步 multimodal-generation，通常约 10-30 秒
# qwen-image-3.0-* / wan*：异步 image-generation + 轮询，通常约 45 秒至数分钟
# 3.0-pro 更慢更贵，仅在重要航线开航等场合手动切换。
POSTER_IMAGE_MODEL=qwen-image-2.0-pro
POSTER_DAILY_LIMIT_PER_USER=10
POSTER_DAILY_LIMIT_TOTAL=50
