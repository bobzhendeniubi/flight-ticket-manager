# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres (matches docker-compose defaults)
DATABASE_URL=postgresql://ftm:ftm_dev_password@localhost:5432/ftm?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# CORS (comma-separated origins, or * for all in dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# WeChat OAuth (fill in M2 when WeChat service account is provisioned)
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# AWS / S3 (fill in M2+ when infra is provisioned)
AWS_REGION=
S3_BUCKET_UPLOADS=

# Flight inventory: max allowed oversell when lowering schedule capacity below sold
# (capacity can go below sold — airline downgauge/aircraft swap — but oversold seats
# beyond this cap are rejected to guard against fat-fingered capacity edits)
FLIGHT_MAX_OVERSELL_SEATS=5
