# 测试环境 env 模板 —— 复制到服务器 /opt/ftm-staging/.env.staging 后填密钥。
#
#   cp infra/env.staging.example /opt/ftm-staging/.env.staging
#   chmod 600 /opt/ftm-staging/.env.staging
#   # 把标了 <生成> 的填上：openssl rand -base64 48 | tr -d '\n='
#
# 与实测环境（/opt/ftm/.env.prod）的关系：
#   - 密钥**必须不同**。共用 JWT secret 意味着测试环境签发的令牌能登实测后台。
#   - 数据库是独立容器 + 独立数据卷，密码抄不抄都行，但别图省事。
#   - 端口必须错开，否则第二套起不来。

# ── 区分两套环境的三个开关 ────────────────────────────────────────
# STACK 决定容器名后缀（ftm-backend-staging），避免和实测的 ftm-backend-prod 撞名
STACK=staging
# 宿主端口：实测 4000/8080/8081，测试 4100/8180/8181
BACKEND_BIND_PORT=4100
ADMIN_WEB_BIND=127.0.0.1:8180
SALES_WEB_BIND=127.0.0.1:8181

# ── 域名 ──────────────────────────────────────────────────────────
APP_PUBLIC_URL=https://test-api.citurtravel.com
CORS_ORIGINS=https://test-store.citurtravel.com,https://test-admin.citurtravel.com
VITE_API_BASE=/api

# ── 密钥（每个都重新生成，别抄实测的）────────────────────────────
POSTGRES_PASSWORD=<生成>
JWT_ACCESS_SECRET=<生成>
JWT_REFRESH_SECRET=<生成>
SANDBOX_WEBHOOK_SECRET=<生成>
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ── 运行时 ────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=debug
PAYMENT_MODE=sandbox
ENABLE_AUTO_FULFILLMENT=true

# ══════════════════════════════════════════════════════════════════
# 对外通道：以下**一律留空，不要填**
#
# 测试库是实测库的整库副本，里面是**真实客人的姓名/护照号/手机/邮箱**。
# 一旦这里配上 SMTP 或微信，测试环境的 worker（提醒引擎、行程单邮件）
# 就会拿真实联系方式往外发 —— 客人会收到测试系统发出的邮件。
#
# 现状（2026-08-24 核过）：实测环境这些也全是空的，所以从来没真发过。
# 保持空 = sendMail() 静默 skip、微信适配器不初始化。
# 哪天要测通知功能，用自己的邮箱开个临时 SMTP，测完立刻清空。
# ══════════════════════════════════════════════════════════════════
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=测试环境（请勿回复） <no-reply@invalid.test>
WECHAT_APPID=
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_SERIAL_NO=
WECHAT_PLATFORM_CERT_PATH=
WECHAT_MP_APPID=
WECHAT_MP_APPSECRET=
ALIPAY_APPID=

# ── AI（可与实测共用同一个 key，测试调用量小）─────────────────────
# 留空则 AI 降级为 mock，不花钱也不报错。
OPENAI_API_KEY=
OPENAI_MODEL=qwen3-max
OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
